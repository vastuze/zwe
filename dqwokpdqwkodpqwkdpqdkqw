                    local watcher = env.AutoPrestigeRewardsWatcher
                    local gold = watcher and watcher.balance and watcher.balance()
                    local prestigeGold = timer and timer.prestigeGoldTarget
                    local boostExpired = timer and goldBoostExpired(timer, player)

                    -- Check if we should return to Lobby instead of retrying
                    if boostExpired then
                        print("[AUTO PRESTIGE] Gold Boost expired. Returning to Lobby!")
                        if stopMissionFarm then stopMissionFarm() end
                        local post = remote("POST")
                        if post then pcall(function() post:FireServer("Functions", "Teleport") end) end
                        local get = remote("GET")
                        if get then pcall(function() get:InvokeServer("Functions", "Teleport", "Lobby") end) end
                        task.wait(5)
                        return
                    end

                    -- Kiểm tra điều kiện đủ Level (>= 100) & đủ Vàng để Prestige
                    local currentLvl = readPlayerLevel(player)
                    local targetLevel = 100
                    local hasLevel = (currentLvl == nil or currentLvl >= targetLevel)
                    local hasGold = (prestigeGold ~= nil and type(gold) == "number" and gold >= prestigeGold)

                    if prestigeGold ~= nil and hasLevel and hasGold and not env.AutoPrestigeNotEligible then
                        print(string.format("[AUTO PRESTIGE] ĐÃ ĐẠT LEVEL %s & ĐỦ VÀNG (%s >= %s) ĐỂ PRESTIGE! Quay về Lobby!",
                            tostring(currentLvl or 100), tostring(gold), tostring(prestigeGold)))
                        if stopMissionFarm then stopMissionFarm() end
                        local post = remote("POST")
                        if post then pcall(function() post:FireServer("Functions", "Teleport") end) end
                        local get = remote("GET")
                        if get then pcall(function() get:InvokeServer("Functions", "Teleport", "Lobby") end) end
                        task.wait(5)
                        return
                    elseif prestigeGold ~= nil then
