        print("[AUTO PRESTIGE] Lobby 2D menu is already visible.")
        return
    end
    local remote = awaitPath(ReplicatedStorage, {"Assets", "Remotes", "POST"})
    assert(remote:IsA("RemoteEvent"), "POST is not a RemoteEvent.")
    print("[AUTO PRESTIGE] Switching Lobby to 2D and opening menu with Tab...")
