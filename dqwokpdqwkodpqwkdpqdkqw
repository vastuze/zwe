-- Auto prestige: Lobby setup, upgrades, 2.5 farm/retry, 3.0 Rewards webhook, timed return.
-- Standalone: does not load or modify titan_pphud.luau.
-- Re-run in Lobby after a place teleport; automatic reinjection is not installed.
-- Step 1.5 spends Gold through the game's Upgrade All button; never spends Gems.
-- Flow: load -> Slot A/Lobby -> Claim All -> Upgrade All/read Grade
-- -> Shiganshina/Breach + 11 modifiers/Start -> farm/retry/skip/webhook
-- -> return at Gold target or 600 seconds -> re-execute in Lobby.
-- Gold is an absolute amount; P1 means the transition from P0 to P1.
repeat task.wait(1) until game:IsLoaded()
local configEnv = type(getgenv) == "function" and getgenv() or _G
-- Configuration is supplied by loadstring.lua before this script runs.
-- Safe fallbacks for standalone execution; never replace explicit loader settings.
if configEnv.UseGoldBoost == nil then
    configEnv.UseGoldBoost = false
    warn("[AUTO PRESTIGE] Loader config missing: Gold Potion purchases disabled. Run loadstring.lua to apply your settings.")
end
if configEnv.GoldPotionHours == nil then configEnv.GoldPotionHours = 2 end
if configEnv.WebhookURL == nil then configEnv.WebhookURL = "" end
if configEnv.Height == nil then configEnv.Height = 400 end
if configEnv.Speed == nil then configEnv.Speed = 350 end
if configEnv.PrestigeSettings == nil then
    configEnv.PrestigeSettings = {
        P1 = {Gold = 200000000}, P2 = {Gold = 400000000}, P3 = {Gold = 600000000},
        P4 = {Gold = 800000000}, P5 = {Gold = 1000000000},
    }
end
if configEnv.Modifiers == nil then
    configEnv.Modifiers = {"No Perks", "No Skills", "No Memories", "Nightmare", "Injury Prone",
        "Chronic Injuries", "Fog", "Glass Cannon", "Time Trial", "Fatigue", "Evolution"}
end
if configEnv.WebhookImageURL == nil then configEnv.WebhookImageURL = "" end
assert(type(configEnv.UseGoldBoost) == "boolean",
    "UseGoldBoost must be true or false WITHOUT quotes; received " .. type(configEnv.UseGoldBoost))
assert(type(configEnv.PrestigeSettings) == "table", "PrestigeSettings must be a table.")
assert(type(configEnv.Modifiers) == "table", "Modifiers must be a list of names.")
do
    local allowed = {"No Perks", "No Skills", "No Memories", "Nightmare", "Injury Prone",
        "Chronic Injuries", "Fog", "Glass Cannon", "Time Trial", "Fatigue", "Evolution",
        "Oddball", "Boring", "Simple", "Primitive"}
    local seen, count = {}, 0
    for index, name in pairs(configEnv.Modifiers) do
        assert(type(index) == "number" and index >= 1 and index % 1 == 0
            and type(name) == "string", "Modifiers must be a consecutive list of strings.")
        local valid = false
        for _, known in ipairs(allowed) do if known == name then valid = true; break end end
        assert(valid and not seen[name], "Unknown or duplicate modifier: " .. tostring(name))
        seen[name], count = true, count + 1
    end
    for index = 1, count do assert(configEnv.Modifiers[index], "Modifiers list must not contain gaps.") end
end
if configEnv.UseGoldBoost then
    assert(type(configEnv.GoldPotionHours) == "number"
        and configEnv.GoldPotionHours >= 0 and configEnv.GoldPotionHours < math.huge
        and (configEnv.GoldPotionHours * 2) % 1 == 0,
        "GoldPotionHours must be a non-negative multiple of 0.5 hours.")
end
assert(type(configEnv.WebhookURL) == "string", "WebhookURL must be a string.")
assert(type(configEnv.WebhookImageURL) == "string"
    and (configEnv.WebhookImageURL == "" or configEnv.WebhookImageURL:match("^https://%S+$")),
    "WebhookImageURL must be empty or a public HTTPS image URL.")
for _, key in ipairs({"Height", "Speed"}) do
    local value = configEnv[key]
    assert(type(value) == "number" and value == value and value > 0 and value < math.huge,
        "" .. key .. " must be a finite positive number.")
end

local function configuredPrestigeGold(rank)
    if type(rank) ~= "number" or rank % 1 ~= 0 or rank < 0 or rank >= 5 then return nil end
    local key = "P" .. tostring(rank + 1)
    local entry = configEnv.PrestigeSettings[key]
    if entry == nil then return 100000000 * (2 ^ rank) end
    assert(type(entry) == "table", "PrestigeSettings." .. key .. " must be a table.")
    local gold = entry.Gold
    if gold == nil then return 100000000 * (2 ^ rank) end
    assert(type(gold) == "number" and gold == gold and gold >= 0 and gold < math.huge
        and gold % 1 == 0, "PrestigeSettings." .. key .. ".Gold must be a finite non-negative integer.")
    return gold
end
for rank = 0, 4 do configuredPrestigeGold(rank) end
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
-- Autoexec may run before the client and game UI have initialized.
while not game:IsLoaded() do task.wait(0.25) end
while not Players.LocalPlayer do task.wait(0.25) end
Players.LocalPlayer:WaitForChild("PlayerGui")
local TIMEOUT = 30
local stopMissionFarm
local function prestigeFile(player)
    return "auto_prestige_rank_" .. tostring(game.GameId) .. "_" .. tostring(player.UserId) .. ".json"
end
local function prestigeTarget(player)
    local env = type(getgenv) == "function" and getgenv() or _G
    local saved = env.AutoPrestigeRank
    if type(readfile) == "function" then
        local ok, value = pcall(function()
            return game:GetService("HttpService"):JSONDecode(readfile(prestigeFile(player)))
        end)
        if ok then saved = value end
    end
    if type(saved) == "table" and saved.userId == player.UserId and saved.gameId == game.GameId
        and type(saved.rank) == "number" and saved.rank >= 0 and saved.rank < 5 then
        local target = configuredPrestigeGold(saved.rank)
        -- Zero removes the Lobby Gold gate, but must not cause instant mission returns.
        if target and target > 0 then return target end
    end
end
