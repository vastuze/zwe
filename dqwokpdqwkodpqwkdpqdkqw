                app.goldBalance = goldLedger.balance
                hiddenAt = hiddenAt or now
                if now - hiddenAt >= 1 then active = nil end
                return
            end
            hiddenAt = nil
            if active ~= main then
                watcher.readyMain = nil
                active, sent, fingerprint = main, false, nil
                openedAt, changedAt, attempts, nextTry = now, now, 0, 0
                matchId = tostring(game.JobId) .. ":" .. tostring(os.time()) .. ":" .. tostring(now)
                matchBase, goldSummary = goldLedger.balance, nil
                gemsBase = goldLedger.gems
                print("[WEBHOOK] Da thay Rewards; cho du lieu tran.")
            end
            if sent or attempts >= 5 or now < nextTry then return end
            local items = childPath(main, {"Info", "Main", "Items"})
            local state = childPath(main, {"Info", "State"})
            if not items or not state or state.Text == "" then return end
            local rows, key, earlyGold, earlyGems = snapshot(items)
            key = state.Text .. "|" .. key
            if key ~= fingerprint then fingerprint, changedAt = key, now end
            if now - openedAt < 0.4 or now - changedAt < 0.2 then return end
            if #rows == 0 and now - openedAt < 2 then return end

            if not goldSummary and (earlyGold or earlyGems) then
                if earlyGold then applyGoldReward(matchId, earlyGold) end
                if earlyGems then applyGemsReward(matchId, earlyGems) end
                if validBalance(matchBase) and earlyGold then
                    goldSummary = {goldLine = "+" .. formatNumber(earlyGold)
                        .. " Gold (Total: " .. formatNumber(matchBase + earlyGold) .. ")"}
                else
                    goldSummary = {}
                end
                if validBalance(gemsBase) and earlyGems then
                    goldSummary.gemsLine = "+" .. formatNumber(earlyGems)
                        .. " Gems (Total: " .. formatNumber(gemsBase + earlyGems) .. ")"
                end
            end
            app.goldBalance = goldLedger.balance
            watcher.readyMain = main

            readHoverNames(items, main)
            if env.AutoPrestigeRewardsWatcher ~= watcher or not visible(main) then return end
            local currentKey, goldReward, gemsReward
            rows, currentKey, goldReward, gemsReward = snapshot(items)
            if not goldSummary then
                if earlyGold or goldReward then applyGoldReward(matchId, goldReward or earlyGold) end
                if earlyGems or gemsReward then applyGemsReward(matchId, gemsReward or earlyGems) end
                goldSummary = goldSummary or {}
            end
            app.goldBalance = goldLedger.balance
            watcher.readyMain = main
            if not app.webhook then sent = true; return end
            watcher.readyMain = main
            attempts = attempts + 1
            local success, reason, delay = send(makeFields(interface, main, rows, goldSummary), state.Text, true)
            if success then
                sent = true
                print("[WEBHOOK] Da gui ket qua tran thanh cong (HTTP 2xx).")
            else
                warn("[WEBHOOK] " .. reason .. " - lan " .. attempts .. "/5")
                nextTry = os.clock() + delay
            end
        end)
        if not ok and os.clock() - lastError >= 5 then
            lastError = os.clock()
            warn("[WEBHOOK] Loi doc PlayerGui; dang thu lai.")
        end
    end
end)
end

local function startMissionFarm()
    local env = type(getgenv) == "function" and getgenv() or _G
    if env.AutoPrestigeFarm and env.AutoPrestigeFarm.stop then env.AutoPrestigeFarm.stop() end
    local player = waitForValue(function() return Players.LocalPlayer end)
    assert(player, "LocalPlayer did not load for Auto Farm.")
