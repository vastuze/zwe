    local function rig(character)
        return workspace:FindFirstChild("Rig_" .. character.Name, true) or character
    end
    local function bladeStatus(character)
        local characters = workspace:FindFirstChild("Characters")
        local model = characters and characters:FindFirstChild(character.Name)
            or workspace:FindFirstChild("Rig_" .. character.Name, true) or character
        -- A missing replicated model is not proof that the blades are empty.
        if not model then return nil, nil end
        local count, segments, slotsFound = 0, 0, 0
        for index = 1, 3 do
            local set = model:FindFirstChild("Left_" .. index, true)
            if set then
                slotsFound = slotsFound + 1
                if not set:GetAttribute("Used") then count = count + 1 end
            end
        end
        if slotsFound == 0 then return nil, nil end
        local seen = {}
        -- Equipped segments may be outside LeftHand. Scan the whole model,
        -- excluding stored sets, so 0/3 reserves does not discard the final blade.
        for _, part in ipairs(model:GetDescendants()) do
            if part:IsA("BasePart") then
                local index = tonumber(part.Name:match("^Blade_(%d+)$"))
                local stored = false
                local ancestor = part.Parent
                while ancestor and ancestor ~= model do
                    if ancestor.Name:match("^Left_[123]$") or ancestor.Name:match("^Right_[123]$") then
                        stored = true
                        break
                    end
                    ancestor = ancestor.Parent
                end
                if index and index >= 1 and index <= 7 and not seen[index]
                    and not stored and not part:GetAttribute("Broken") and part.Transparency < 1 then
                    seen[index] = true
                    segments = segments + 1
                end
            end
        end
        return count, segments
    end
    local function getRefillPart()
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        -- 1. Known HQ paths (Breach, Waves, Props)
        for _, names in ipairs({
            {"Unclimbable", "Objective", "Breach", "HQ"},
            {"Unclimbable", "Objective", "Waves"},
            {"Unclimbable", "Props", "HQ"},
        }) do
            local hq = path(workspace, names)
            if hq then
                local nearest, distance = nil, math.huge
                for _, part in ipairs(hq:GetDescendants()) do
                    if part.Name == "Refill" and part:IsA("BasePart") then
                        local magnitude = root and (root.Position - part.Position).Magnitude or 0
                        if magnitude < distance then nearest, distance = part, magnitude end
                    end
                end
                if nearest then return nearest end
            end
        end
        -- 2. Fallback: Search all of Unclimbable
        local unclimbable = workspace:FindFirstChild("Unclimbable")
        if unclimbable then
            local nearest, distance = nil, math.huge
            for _, part in ipairs(unclimbable:GetDescendants()) do
                if part.Name == "Refill" and part:IsA("BasePart") then
                    local magnitude = root and (root.Position - part.Position).Magnitude or 0
                    if magnitude < distance then nearest, distance = part, magnitude end
                end
            end
            if nearest then return nearest end
        end
        -- 3. Universal Fallback: Search entire workspace
        local nearest, distance = nil, math.huge
        for _, part in ipairs(workspace:GetDescendants()) do
            if part.Name == "Refill" and part:IsA("BasePart") then
                local magnitude = root and (root.Position - part.Position).Magnitude or 0
                if magnitude < distance then nearest, distance = part, magnitude end
            end
        end
        return nearest
    end
    local function napeOf(titan)
        return path(titan, {"Hitboxes", "Hit", "Nape"}) or titan:FindFirstChild("Nape", true)
    end
    local lastRefillWarning = -10
    local emptySince, emptyCharacter
    local function refillWarning(message)
        if os.clock() - lastRefillWarning >= 10 then
            lastRefillWarning = os.clock()
            warn("[AUTO PRESTIGE] Refill: " .. message)
        end
    end
    local waitReason, waitLoggedAt
    local function reportFarmWait(reason)
        if waitReason ~= reason or not waitLoggedAt or os.clock() - waitLoggedAt >= 5 then
            print("[AUTO PRESTIGE] Farm waiting: " .. reason)
            waitLoggedAt = os.clock()
        end
        waitReason = reason
    end
    local function iteration()
        if not canFarm() then task.wait(0.1); return end
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid or humanoid.Health <= 0 then
            reportFarmWait("character/root/humanoid not ready")
            release(); task.wait(0.1); return
        end
        local function valid()
            return canFarm() and player.Character == character and root.Parent == character and humanoid.Health > 0
        end
        local setsLeft, segmentsLeft = bladeStatus(character)
        if setsLeft == nil then
            emptySince, emptyCharacter = nil, nil
            refillWarning("Blade slots not replicated; cannot determine remaining sets.")
            reportFarmWait("blade reserve slots not replicated")
            release(); task.wait(0.1); return
        end
        if setsLeft == 0 and segmentsLeft == 0 then
            local station, post = getRefillPart(), remote("POST")
            if station and post and post:IsA("RemoteEvent") and valid() then
                local oldCF = root.CFrame
                local restored = false
                local function restore()
                    if restored or not valid() then return end
                    restored = true
                    root.CFrame = CFrame.new(oldCF.Position.X, math.max(configEnv.Height, oldCF.Position.Y), oldCF.Position.Z)
                        * oldCF.Rotation
                    root.Anchored = true
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
                print("[AUTO PRESTIGE] Blades empty: Teleport refill -> Bắn Remote -> đợi 0.5s -> về vị trí cũ!")
                pcall(function()
                    clearRefillHold()
                    root.Anchored = false
                    root.CFrame = station.CFrame + Vector3.new(0, 3, 0)
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

                    post:FireServer("Attacks", "Reload", station)
                    key(Enum.KeyCode.R)
                end)
                -- Đứng tại trạm refill 0.5s cho server kịp nạp lưỡi rồi mới teleport về.
                local waitUntil = os.clock() + 0.5
                while valid() and os.clock() < waitUntil do task.wait(0.05) end
                restore()
                emptySince, emptyCharacter = nil, nil
            else
                refillWarning(not station and "HQ refill part not found."
                    or "POST remote or character not ready.")
                task.wait(0.5)
            end
            return
        end
        emptySince, emptyCharacter = nil, nil
        clearRefillHold()
        local titans = workspace:FindFirstChild("Titans")
        local target, nape, nearest = nil, nil, math.huge
        if titans then
            for _, titan in ipairs(titans:GetChildren()) do
                local hum = titan:IsA("Model") and titan:FindFirstChild("Humanoid")
                local neck = hum and napeOf(titan)
                if hum and hum.Health > 0 and neck and neck:IsA("BasePart") then
                    local distance = (root.Position - neck.Position).Magnitude
                    if distance < nearest then target, nape, nearest = titan, neck, distance end
                end
            end
        end
        if not target then
            reportFarmWait("no living titan with a replicated Nape hitbox")
            root.Anchored = false
            task.wait(0.1)
            if not valid() then release() end
            return
        end
        if waitReason then
            print("[AUTO PRESTIGE] Farm ready; target: " .. target.Name)
            waitReason, waitLoggedAt = nil, nil
        end
        local hand = rig(character):FindFirstChild("LeftHand", true)
        local blade = hand and hand:FindFirstChild("Blade_1")
        if (setsLeft and setsLeft > 0 and segmentsLeft == 0) or (blade and blade:GetAttribute("Broken") == true) then
            root.Anchored = true
            key(Enum.KeyCode.R)
            task.wait(0.6)
            root.Anchored = false
        end
        if not valid() or not nape.Parent then return end
        root.Anchored = false
        local height = math.max(configEnv.Height, nape.Position.Y + 50)
        holdHeight(character, root, height)
        local destination = CFrame.new(nape.Position.X, height, nape.Position.Z) * CFrame.new(0, 0, 2)
        local duration = math.max(0.05, (root.Position - destination.Position).Magnitude / configEnv.Speed)
        local tween = tweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = destination})
        farm.tween = tween
        local finished, playbackState = false, nil
        local completedConnection = tween.Completed:Connect(function(state)
            playbackState, finished = state, true
        end)
        tween:Play()
        local empty = false
        -- Wait for actual completion, retaining cancellation for Skip/refill/Lobby.
        while valid() and nape.Parent and not finished do
            local sets, segments = bladeStatus(character)
            if sets == 0 and segments == 0 then empty = true; break end
            task.wait(0.05)
        end
        if not finished then tween:Cancel() end
        completedConnection:Disconnect()
        if farm.tween == tween then farm.tween = nil end
        if empty then
            if valid() then holdBeforeRefill(root) else release() end
            return
        end
        if not valid() or not nape.Parent then release(); return end
        if playbackState ~= Enum.PlaybackState.Completed then return end
        root.Anchored = true
        stopHeightGuard()
        root.AssemblyLinearVelocity = Vector3.zero
        lockCamera()
        local post = remote("POST")
        if post then
            pcall(function()
                post:FireServer("Attacks", "Slash", true)
                post:FireServer("Hitboxes", "Register", nape, math.random() * 0.1 + 0.05)
                post:FireServer("Attacks", "Slash", false)
            end)
        end
        input:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        input:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        task.wait(0.15)
        -- Keep the character anchored between farm iterations, not during refill/cutscenes.
        if valid() then root.Anchored = true else release() end
    end
    task.spawn(function()
        while active() do
            local ok, err = pcall(iteration)
            if not ok then release(); warn("[AUTO PRESTIGE] Farm: " .. tostring(err)); task.wait(1) end
            task.wait()
        end
        farm.stop()
    end)
    print("[AUTO PRESTIGE] Step 2.5: Auto Farm + Auto Retry enabled (no HUD).")
end

local function ensureLobby2D(player)
    local interface = awaitPath(player, {"PlayerGui", "Interface"})
    local categories = awaitPath(interface, {"Topbar", "Main", "Categories"})
    local function menuVisible()
        if not interface.Parent then return false end
        local topbar = interface:FindFirstChild("Topbar")
        local main = topbar and topbar:FindFirstChild("Main")
        if not topbar or not main then return false end
        local shown = isVisible(topbar) and isVisible(main) and isVisible(categories)
        if not shown then return false end
        for _, name in ipairs({"Equipment", "Inventory", "Market"}) do
            local category = categories:FindFirstChild(name)
            local interact = category and category:FindFirstChild("Interact")
            if interact and isVisible(interact) then return true end
        end
        return false
    end
    if menuVisible() then
        print("[AUTO PRESTIGE] Lobby 2D menu is already visible.")
        return
    end
    local remote = awaitPath(ReplicatedStorage, {"Assets", "Remotes", "POST"})
    assert(remote:IsA("RemoteEvent"), "POST is not a RemoteEvent.")
    print("[AUTO PRESTIGE] Switching Lobby to 2D and opening menu with Tab...")
    remote:FireServer("Functions", "Switch", "2D")
    task.wait(0.8)
    local input = game:GetService("VirtualInputManager")
    input:SendKeyEvent(true, Enum.KeyCode.Tab, false, game)
    task.wait(0.08)
    input:SendKeyEvent(false, Enum.KeyCode.Tab, false, game)
    local deadline = os.clock() + 15
    repeat
        if menuVisible() then
            print("[AUTO PRESTIGE] Lobby 2D menu opened; continuing setup.")
            return
        end
        task.wait(0.2)
    until os.clock() >= deadline
    error("Lobby menu did not appear after POST Switch 2D + Tab.")
end

local function closePanel(player, panelName)
    local interface = findPath(player, {"PlayerGui", "Interface"})
    local panel = interface and interface:FindFirstChild(panelName)
    if not panel or not isVisible(panel) then return end
    local function closed()
        local deadline = os.clock() + 5
        repeat
            if not isVisible(panel) then return true end
            task.wait(0.1)
        until os.clock() >= deadline
        return false
    end
    local function closeButton(parent)
        for _, candidate in ipairs(parent and parent:GetDescendants() or {}) do
            if candidate:IsA("GuiButton") and isVisible(candidate) and candidate.Name:match("Close$") then
                return candidate
            end
        end
    end
    for _, parent in ipairs({panel:FindFirstChild("Top"), panel}) do
        local button = closeButton(parent)
        if button then
            if pcall(click, button, "MouseButton1Click") and closed() then return end
            break
        end
    end
    -- The category button toggles the open panel; only used after a named close failed.
    local entry = findPath(interface, {"Topbar", "Main", "Categories", panelName, "Interact"})
    if entry and entry:IsA("GuiButton") and isVisible(entry) then
        pcall(click, entry, "MouseButton1Click")
        if closed() then return end
    end
    warn("[POTION] " .. panelName .. " panel could not be closed.")
end

-- An account without enough Gems cannot buy a Gold Boost in Lobby. Farming is the
-- way to earn them, so the potion step must never block the mission start.
local function potionUnavailable(reason)
    print("[POTION] " .. reason .. "; farming without a Gold Boost.")
end

local function chooseGoldPotion(balance, products, remainingSeconds)
    if remainingSeconds <= 0 then return nil end
    for _, product in ipairs(products) do
        if balance >= product.cost and product.seconds <= remainingSeconds then return product end
    end
    local smallest = products[#products]
    if smallest and remainingSeconds < smallest.seconds and balance >= smallest.cost then return smallest end
end

local function purchaseGoldPotion(player)
    print("[POTION] Effective config: UseGoldBoost=" .. tostring(configEnv.UseGoldBoost)
        .. " | GoldPotionHours=" .. tostring(configEnv.GoldPotionHours))
    if not configEnv.UseGoldBoost or configEnv.GoldPotionHours == 0 then
        print("[POTION] Disabled by effective config; skipping.")
        return
    end
    local targetSeconds = configEnv.GoldPotionHours * 3600
    local interface = awaitPath(player, {"PlayerGui", "Interface"})
    local function timer()
        local value = findPath(player, {"Boosts", "Gold"})
        if value and (value:IsA("NumberValue") or value:IsA("IntValue"))
            and value.Value >= 0 and value.Value < math.huge then return value.Value end
    end
    local initial = timer()
    if not initial then
        potionUnavailable("Gold Potion timer unavailable")
        return
    end
    print("[POTION] Remaining=" .. initial .. "s | Target=" .. targetSeconds .. "s")
    if initial >= targetSeconds - 10 then
        -- An active potion must also mark "used" so the next mission can return
        -- to Lobby when its timer reaches zero.
        local activeEnv = type(getgenv) == "function" and getgenv() or _G
        activeEnv.AutoPrestigeGoldPotionUsed = true
        print("[AUTO PRESTIGE] Gold Potion target already met. Remaining seconds: " .. initial)
        return true
    end
    local shop = require(ReplicatedStorage.Modules.Storage.Shop)
    local products = {
        {index = 9, tag = "2x Gold Boost [2h]", cost = 13999, seconds = 7200},
        {index = 8, tag = "2x Gold Boost [1h]", cost = 7999, seconds = 3600},
        {index = 7, tag = "2x Gold Boost [30m]", cost = 4499, seconds = 1800},
    }
    for _, product in ipairs(products) do
        local entry = shop["1_Boosts"] and shop["1_Boosts"][product.index]
        if not (entry and entry.Tag == product.tag and entry.Currency == "Gems"
            and entry.Cost == product.cost) then
            potionUnavailable("Gold Potion product/price changed in Shop (1_Boosts)")
            return
        end
    end
    local topbar = require(ReplicatedStorage.Modules["User Interface"].Topbar)
    local function getGems()
        for _, entry in pairs(topbar.Objects) do
            if entry.Module == "Topbar" and entry.Currency == "Gems" and entry.Object then
                local amount = entry.Object:GetAttribute("New")
                if type(amount) == "number" and amount >= 0 then return amount end
            end
        end
        local label = findPath(interface, {"Topbar", "Main", "Currencies", "Gems", "Amount"})
        local text = label and label.Text:gsub("<[^>]*>", ""):gsub(",", ""):gsub("%s", "")
        if text and text:match("^%d+$") then return tonumber(text) end
    end

    local balance = getGems()
    if not (balance and balance >= 0 and balance < math.huge) then
        potionUnavailable("Exact Gems balance unavailable")
        return
    end
    print("[POTION] Gems available: " .. balance)
    local remote = awaitPath(ReplicatedStorage, {"Assets", "Remotes", "GET"})
    -- Recheck after UI transitions in case a potion was activated meanwhile.
    local current = timer()
    if not current then
        potionUnavailable("Gold Potion timer unavailable")
        return
    end
    -- Ignore ten seconds of countdown drift; never buy another whole potion for that alone.
    if current >= targetSeconds - 10 then return true end
    if balance < 4499 then
        potionUnavailable("Not enough Gems (" .. balance .. " < 4499)")
        return
    end
    local remainingSeconds = math.ceil((targetSeconds - current - 10) / 1800) * 1800
    local limit = math.min(math.floor(balance / 4499), math.ceil(remainingSeconds / 1800))
    for _ = 1, limit do
        local live = timer()
        assert(live, "Potion timer lost; stopping purchases.")
        if live >= targetSeconds - 10 then break end
        remainingSeconds = math.min(remainingSeconds,
            math.ceil((targetSeconds - live - 10) / 1800) * 1800)
        local product = chooseGoldPotion(balance, products, remainingSeconds)
        if not product then break end
        assert(timer(), "Potion timer lost; stopping purchases.")
        print("[AUTO PRESTIGE] Buying " .. product.tag .. " for " .. product.cost .. " Gems.")
        print("[AUTO PRESTIGE] Buy request: 1_Boosts[" .. product.index .. "] cost "
            .. product.cost .. " | Gems " .. balance)
        local data = remote:InvokeServer("S_Market", "Buy", "1_Boosts", product.index, 1)
        if type(data) ~= "table" then
            error("Potion purchase refused (Gems " .. balance .. ", server returned "
                .. type(data) .. "); no retry.")
        end
        local slot = data.Slots and data.Slots[data.Current_Slot]
        local remaining = slot and slot.Currency and slot.Currency.Gems
        if type(remaining) ~= "number" then remaining = getGems() end
        if type(remaining) ~= "number" then remaining = balance - product.cost end
        balance = remaining
        -- Subtract purchased duration so countdown during requests cannot trigger extra purchases.
        remainingSeconds = remainingSeconds - product.seconds
        local before = timer()
        assert(before, "Potion bought but timer lost; leaving item in inventory.")
        remote:InvokeServer("S_Inventory", "Item", product.tag)
        assert(waitForValue(function()
            local after = timer()
            return after and after - before >= product.seconds - 60
        end), "Potion use not confirmed; no further purchase or use.")
        -- Persist proof that a Gold potion was activated so the next mission can
        -- return to Lobby when the timer reaches zero, even if it expired on join.
        local boostEnv = type(getgenv) == "function" and getgenv() or _G
        boostEnv.AutoPrestigeGoldPotionUsed = true
        print("[AUTO PRESTIGE] Potion confirmed; Gems: " .. balance .. " | Timer: " .. tostring(timer()))
        local seconds = math.floor(timer())
        sendLobbyResult("GOLD POTION USED", {
            {name = "Potion", value = product.tag, inline = true},
            {name = "Gems remaining", value = tostring(balance), inline = true},
            {name = "Remaining Time", value = string.format("%02d:%02d:%02d",
                math.floor(seconds / 3600), math.floor(seconds / 60) % 60, seconds % 60), inline = true},
        })
        task.wait(0.3)
    end
    local final = timer()
    if final and final >= targetSeconds - 10 then
        print("[POTION] Target reached: " .. final .. "s | Gems: " .. balance)
        return true
    end
    warn("[POTION] Target NOT reached: remaining=" .. tostring(final) .. "s / " .. targetSeconds
        .. "s | Gems=" .. balance .. "; continuing farm without claiming success.")
end

-- The potion step is optional: never block the mission on a failed purchase, and
-- always close the Market panel it opened so Equipment/Create stays clickable.
local function ensureGoldPotion(player)
    local ok, result = pcall(purchaseGoldPotion, player)
    if not ok then
        potionUnavailable("Gold Potion step stopped: " .. tostring(result))
        result = nil
    end
    -- goldBoostExpired treats the "used" flag as proof a potion was active. Keeping it
    -- set with no boost returns every mission to Lobby immediately, so drop it when the
    -- usable timer reads zero and no purchase was confirmed this cycle.
    if result then return end
    local boost = findPath(player, {"Boosts", "Gold"})
    if boost and (boost:IsA("NumberValue") or boost:IsA("IntValue")) and boost.Value > 0 then return end
    local env = type(getgenv) == "function" and getgenv() or _G
    env.AutoPrestigeGoldPotionUsed = nil
end

local function waitLobbyAutoexec(player)
    print("[AUTO PRESTIGE] Autoexec: waiting at least 15 seconds for Lobby initialization...")
    local started = os.clock()
    local stableSince, previousUI
    repeat
        local ui = findPath(player, {"PlayerGui", "Interface"})
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local ready = root and ui and findPath(ui, {"Topbar", "Main", "Categories", "Equipment", "Interact"})
            and findPath(ui, {"Topbar", "Main", "Categories", "Market", "Interact"})
            and ui:FindFirstChild("Equipment") and ui:FindFirstChild("Market")
            and findPath(player, {"Boosts", "Gold"})
        if ready and ui == previousUI then
            stableSince = stableSince or os.clock()
        else
            stableSince = nil
        end
        previousUI = ui
        if stableSince and os.clock() - stableSince >= 3 and os.clock() - started >= 5 then
            print("[AUTO PRESTIGE] Lobby UI loaded; starting menu setup.")
            return
        end
        task.wait(0.25)
    until os.clock() - started >= 120
    error("Lobby UI initialization timed out; no purchase started.")
end

local function runPrestigeFlow()
    -- A new execution resumes the appropriate branch after each place teleport.
    if inMission() then
        print("[AUTO PRESTIGE] Map: Auto Farm + Retry + Skip + Rewards Webhook.")
        print("[POTION] Mission branch: top-up purchases run in Lobby, not inside missions.")
        startRewardsWebhook()
        startLobbyTimer()
        startMissionFarm()
        return
    end

    -- Menu: select Slot A and request Lobby; never run Lobby UI in the menu.
    if not selectLobby() then
        print("[AUTO PRESTIGE] Re-run in Lobby: Upgrade All -> Grade -> mission.")
        return
    end
    local player = waitForValue(function() return Players.LocalPlayer end)
    assert(player, "LocalPlayer did not load.")
    waitLobbyAutoexec(player)
    ensureLobby2D(player)

    -- Background balance capture must run in Lobby too, to carry Gold/Gems into map.
    startRewardsWebhook()
    print("[AUTO PRESTIGE] Lobby: Gold Potion -> Prestige -> Upgrades.")
    -- Prestige is checked before Upgrade All can spend the threshold balance.
    ensureGoldPotion(player)
    -- A missing or zero Gold Boost must not stop the run: a fresh account has to
    -- farm Gems without a boost before it can buy one.
    if configEnv.UseGoldBoost and configEnv.GoldPotionHours and configEnv.GoldPotionHours > 0 then
        local boostNow = findPath(player, {"Boosts", "Gold"})
        local remaining = boostNow and (boostNow:IsA("NumberValue") or boostNow:IsA("IntValue"))
            and boostNow.Value or nil
        if type(remaining) == "number" and remaining > 0 then
            print("[AUTO PRESTIGE] Gold Boost active: " .. math.floor(remaining) .. "s; entering mission.")
        elseif type(remaining) == "number" then
            warn("[AUTO PRESTIGE] Gold Boost timer is zero; entering mission without a boost.")
        else
            -- Mobile replication can lag behind the Lobby purchase. A missing timer is
            -- unknown, not proof of expiry; blocking here stalls the whole flow.
            warn("[AUTO PRESTIGE] Gold Boost timer unreadable before mission; "
                .. "continuing on the Lobby purchase confirmation.")
        end
    end
    tryPrestige(player)
    pcall(autoCleanPerks, player)
    local difficulty = readDifficulty(player)
    print("[AUTO PRESTIGE] Mission: Shiganshina/Breach -> configured modifiers -> Start.")
    startMission(player, difficulty)
end

    local ok, message = pcall(runPrestigeFlow)
if not ok then warn("[AUTO PRESTIGE] Stopped: " .. tostring(message)) end
