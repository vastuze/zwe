                                currentLvl, targetLevel))
                        elseif not hasGold then
                            print(string.format("[AUTO PRESTIGE] Cày Prestige: Vàng hiện tại %s / %s. Chưa đủ Vàng -> Tiếp tục Retry!",
                                tostring(gold or 0), tostring(prestigeGold)))
                        end
                    end

                    local isMaxGrade = timer and timer.isMaxGrade or false
                    local gradeGoldTarget = timer and timer.gradeGoldTarget
                    local targetGrade = timer and timer.gradeTag
                    if not isMaxGrade and type(gradeGoldTarget) == "number" and type(gold) == "number"
                        and gold >= gradeGoldTarget then
                        print("[AUTO PRESTIGE] ĐỦ VÀNG để lên Grade " .. tostring(targetGrade or "kế tiếp") .. " (" .. tostring(gold) .. " >= " .. tostring(gradeGoldTarget) .. "). Quay về Lobby nâng cấp!")
                        if stopMissionFarm then stopMissionFarm() end
                        local post = remote("POST")
                        if post then pcall(function() post:FireServer("Functions", "Teleport") end) end
                        local get = remote("GET")
                        if get then pcall(function() get:InvokeServer("Functions", "Teleport", "Lobby") end) end
                        task.wait(5)
                        return
                    else
                        if gradeGoldTarget then
                            print(string.format("[AUTO PRESTIGE] Vàng hiện có: %s / %s (để lên %s). Chưa đủ vàng -> Tiếp tục Retry!",
                                tostring(gold or 0), tostring(gradeGoldTarget), tostring(targetGrade or "Next")))
                        end
                    end

                    -- Nút "RETRY (0/1)" = đã dùng 0/1 lượt, còn 1 lượt -> vẫn retry được.
                    local used, total = retryUsage(rewards)
                    local exhausted = used ~= nil and total ~= nil and used >= total
                    -- Vừa bấm retry của mình nên bộ đếm lên 1/1: đang chờ "STARTING", không bấm LEAVE.
                    if (exhausted and not clickedRetry) or retryCount >= 20 then
                        print("[AUTO PRESTIGE] Không retry được ("
                            .. (exhausted and not clickedRetry
                                and ("RETRY " .. tostring(used) .. "/" .. tostring(total) .. " đã dùng hết")
                                or "retry không phản hồi")
                            .. "). Bấm LEAVE để về Lobby!")
                        if stopMissionFarm then stopMissionFarm() end
                        triggerLeaveButton(rewards)
                        task.wait(5)
                        if inMission() then
                            local post = remote("POST")
                            if post then pcall(function() post:FireServer("Functions", "Teleport") end) end
                            local get = remote("GET")
                            if get then pcall(function() get:InvokeServer("Functions", "Teleport", "Lobby") end) end
