    -- Camera lock belongs to this farm run; a rerun releases the previous lock.
    if farm.cameraRelease then farm.cameraRelease() end
    local cameraLock
    local function releaseCamera()
        if not cameraLock then return end
        local lock = cameraLock
        cameraLock = nil
        farm.cameraRelease = nil
        if lock.connection then lock.connection:Disconnect() end
        local camera = workspace.CurrentCamera
        if camera and lock.character and lock.character.Parent then
            camera.CameraType = Enum.CameraType.Custom
            camera.CameraSubject = lock.character:FindFirstChildOfClass("Humanoid") or lock.character
        end
    end
    farm.cameraRelease = releaseCamera
    local function lockCamera()
        local camera = workspace.CurrentCamera
        if not camera then return end
        releaseCamera()
        cameraLock = {character = player.Character, cframe = camera.CFrame}
        camera.CameraType = Enum.CameraType.Scriptable
        camera.CFrame = cameraLock.cframe
        cameraLock.connection = runService.RenderStepped:Connect(function()
            local current = workspace.CurrentCamera
            if current and cameraLock then
                current.CameraType = Enum.CameraType.Scriptable
                current.CFrame = cameraLock.cframe
            end
        end)
    end
    local function active()
        local timer = env.AutoPrestigeLobbyTimer
        local expired = timer and timer.deadline and os.clock() >= timer.deadline
        return farm.running and env.AutoPrestigeFarm == farm and inMission()
            and not (timer and (timer.leaving or expired))
            and not (timer and goldBoostExpired(timer, player))
    end

