                        task.wait(5)
                        return
                    end

                    -- If not leaving to Lobby: Send Retry (retry every 1.5s while Rewards is visible)
                    if os.clock() - lastRetryTime >= 1.5 then
                        lastRetryTime = os.clock()
                        retryCount = retryCount + 1
                        print(string.format("[AUTO PRESTIGE] Rewards screen visible: Gửi yêu cầu Retry lần %d...", retryCount))

                        local get = remote("GET")
                        if get and get:IsA("RemoteFunction") then
                            local ok, res = pcall(function() return get:InvokeServer("Functions", "Retry", "Add") end)
                            if not ok then warn("[AUTO PRESTIGE] GET Retry failed: " .. tostring(res)) end
                        end

                        local post = remote("POST")
                        if post then pcall(function() post:FireServer("Functions", "Retry", "Add") end) end
                        if post then pcall(function() post:FireServer("Functions", "Retry") end) end

                        local clicked = triggerRetryButton(rewards)
                        if clicked then
                            clickedRetry = true
                            print("[AUTO PRESTIGE] Đã kích hoạt nút Retry trên giao diện Rewards!")
                        end
                    end
                end
            else
                retryCount = 0
                lastRetryTime = 0
                clickedRetry = false
            end
        end
    end)
