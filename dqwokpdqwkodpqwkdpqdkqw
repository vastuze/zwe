-- Read the replicated potion timer, the same source used by Gear_Up.Boost_Display.
local function goldPotionText(name)
    local gold = childPath(player, {"Boosts", name or "Gold"})
    if not gold or not (gold:IsA("NumberValue") or gold:IsA("IntValue")) then
        return "Chua doc duoc timer"
    end
    local seconds = gold.Value
    if type(seconds) ~= "number" or seconds ~= seconds or seconds == math.huge or seconds == -math.huge then
        return "Timer khong hop le"
    end
    seconds = math.max(0, math.floor(seconds))
    return string.format("%02d:%02d:%02d", math.floor(seconds / 3600),
        math.floor(seconds / 60) % 60, seconds % 60)
end

local function boostsText()
    local folder = player:FindFirstChild("Boosts")
    if not folder then return "Chua doc duoc boosts" end
    local lines = {}
    for _, boost in ipairs(folder:GetChildren()) do
        if boost:IsA("NumberValue") or boost:IsA("IntValue") then
            local multiplier = boost:GetAttribute("Multiplier")
            local base = type(multiplier) == "number" and multiplier >= 0 and multiplier < math.huge
                and multiplier or nil
            local suffix = base and (" | Base " .. tostring(base) .. "x") or ""
            lines[#lines + 1] = boost.Name .. ": " .. goldPotionText(boost.Name):gsub("\n", " - ") .. suffix
        end
    end
    table.sort(lines)
    return #lines > 0 and table.concat(lines, "\n"):sub(1, 1000) or "Khong co du lieu boost"
end

