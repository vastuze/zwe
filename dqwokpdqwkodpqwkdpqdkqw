    local function saveRank(rank)
        local env = type(getgenv) == "function" and getgenv() or _G
        local data = {rank = rank, userId = player.UserId, gameId = game.GameId}
        env.AutoPrestigeRank = data
        if type(writefile) == "function" then
            writefile(prestigeFile(player), game:GetService("HttpService"):JSONEncode(data))
        end
    end
    local rank = readRank()
    assert(rank ~= nil, "4.0: Cannot identify Prestige rank; stopping before purchases/reset.")
    saveRank(rank)
    if not ranks[rank + 1] then return end
    local topbar = require(ReplicatedStorage.Modules["User Interface"].Topbar)
    local gold
    for _, entry in pairs(topbar.Objects) do
        if entry.Module == "Topbar" and entry.Currency == "Gold" and entry.Object then
            gold = entry.Object:GetAttribute("New")
        end
    end
    if type(gold) ~= "number" then
        local text = awaitPath(interface, {"Topbar", "Main", "Currencies", "Gold", "Amount"}).Text
        text = text:gsub("<[^>]*>", ""):gsub(",", ""):gsub("%s", "")
        if text:match("^%d+$") then gold = tonumber(text) end
    end
    local target = configuredPrestigeGold(rank)
    if target == nil then
        print("[AUTO PRESTIGE] P1-P5 configuration complete; skipping further Prestige.")
        return
    end
    print("[AUTO PRESTIGE] 4.0: P" .. rank .. " | Gold " .. tostring(gold) .. " | Target " .. target)
    if target > 0 and (type(gold) ~= "number" or gold < target) then
        print("[AUTO PRESTIGE] Prestige skipped: Gold below target or exact balance unavailable.")
        return
    end
    local start = awaitPath(equipment, {"Prestige", "B_Prestige"})
    if not isVisible(start) then
        print("[AUTO PRESTIGE] 4.0: Gold ready, but Level/XP or next-rank eligibility not ready.")
        return
    end
    local function waitUntil(callback, description, seconds)
        local deadline = os.clock() + (seconds or 30)
        repeat
            local result = callback()
            if result then return result end
            task.wait(0.1)
        until os.clock() >= deadline
        error("4.0 timeout: " .. description .. "; no automatic reset retry.")
    end
    local warning = awaitPath(interface, {"Warning"})
    assert(not isVisible(warning), "4.0: Another confirmation is open.")
    click(start)
    waitUntil(function()
        local title = findPath(warning, {"Prompt", "Main", "Title"})
        return isVisible(warning) and title and title.Text:lower():find("prestige", 1, true)
    end, "Prestige confirmation")
    task.wait(0.3)
    click(awaitPath(warning, {"Prompt", "Main", "Yes"}))
    local memories = require(ReplicatedStorage.Modules.Storage.Memories)
    local function cardFrame(card)
        return findPath(card, {"Holder", "Front", "Main"})
    end
    local function liveCards(category)
        local root = findPath(workspace, {"Objects", "Blackout", "Memories"})
        local found = {}
        for _, card in ipairs(root and root:GetChildren() or {}) do
            local info = findPath(card, {"Holder", "Front", "Main", "Inner", "Info"})
            if info and info:GetAttribute("Category") == category then
                found[#found + 1] = card
            end
        end
        return found
    end
    local function offered(category, seconds)
        local previous, stableSince = {}, os.clock()
        local list = waitUntil(function()
            local found = liveCards(category)
            local same = #found == #previous
            for index, card in ipairs(found) do
                if previous[index] ~= card then same = false end
            end
            if not same then previous, stableSince = found, os.clock() end
            if #found > 0 and os.clock() - stableSince >= 1.5
                and (category ~= "Boosts" or #found == 3) then return found end
        end, category .. " cards dealt", seconds)
        local names = {}
        for _, card in ipairs(list) do names[#names + 1] = card.Name end
        print("[AUTO PRESTIGE] 4.0 " .. category .. " offers: " .. table.concat(names, ", "))
        return list
    end
    local confirm = awaitPath(interface, {"Memories_Buttons", "M_Confirm"})
    local virtualInput = game:GetService("VirtualInputManager")
    local function registered(expectedText, seconds)
        local deadline = os.clock() + (seconds or 2)
        repeat
            if isVisible(confirm) and confirm.Title.Text:upper() == expectedText then return true end
            task.wait(0.1)
        until os.clock() >= deadline
        return false
    end
    -- Path 1: dispatch the module's own MouseClick handler.
    local function fireHandlers(detector)
        if type(getconnections) ~= "function" then return false end
        local ok, handlers = pcall(function() return getconnections(detector.MouseClick) end)
        if not ok or type(handlers) ~= "table" or #handlers == 0 then return false end
        local fired = false
        for _, connection in ipairs(handlers) do
            if connection.Enabled ~= false then
                local success = pcall(function() connection:Fire(player) end)
                fired = fired or success
            end
        end
        return fired
    end
    -- Path 2: executor click-detector emulation for executors that block getconnections.
    local function fireDetector(detector)
        local call = type(fireclickdetector) == "function" and fireclickdetector
            or type(getgenv) == "function" and getgenv().fireclickdetector
        if type(call) ~= "function" then return false end
        return (pcall(call, detector))
    end
    -- Path 3: real mouse click on the card part. Some ClickDetectors ignore synthetic
    -- handler fires but honour a mouse click at the part's viewport position.
    local function fireVirtual(card)
        local camera = workspace.CurrentCamera
        if not camera then return false end
        -- Click the card part, not its separate Info detector.
        local part = card:IsA("BasePart") and card or card:FindFirstChildWhichIsA("BasePart", true)
        if not part then return false end
        local position, onScreen = camera:WorldToScreenPoint(part.Position)
        if not onScreen or position.Z <= 0 then return false end
        local x, y = position.X, position.Y
        local ok = pcall(function()
            virtualInput:SendMouseMoveEvent(x, y, game)
            task.wait(0.08)
            virtualInput:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.wait(0.08)
            virtualInput:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
        return ok
    end
    local function clickVirtual(button, expectedText)
        if not button.Parent or not isVisible(button) then return false end
        local position, size = button.AbsolutePosition, button.AbsoluteSize
        if size.X <= 0 or size.Y <= 0 then return false end
        local x, y = position.X + size.X / 2, position.Y + size.Y / 2
        print("[AUTO PRESTIGE] 4.0 virtual confirm click: " .. expectedText
            .. " at " .. math.floor(x) .. "," .. math.floor(y))
        local ok, message = pcall(function()
            virtualInput:SendMouseMoveEvent(x, y, game)
            task.wait(0.15)
            virtualInput:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.wait(0.1)
            virtualInput:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
        if not ok then warn("[AUTO PRESTIGE] 4.0 virtual confirm failed: " .. tostring(message)) end
        return ok
    end
    local selectedCard
    local function confirmationAccepted(expectedText)
        if expectedText == "NEXT" then
            return #liveCards("Talents") > 0
                or (selectedCard and selectedCard.Parent == nil)
        end
        return (selectedCard and selectedCard.Parent == nil)
            or not isVisible(interface:FindFirstChild("Memories_Buttons"))
    end
    local function pressConfirm(expectedText)
        waitUntil(function()
            return isVisible(confirm) and confirm.Title.Text:upper() == expectedText
        end, "visible " .. expectedText .. " button")
        task.wait(0.4)
        local deadline = os.clock() + 30
        local attempt = 0
        while not confirmationAccepted(expectedText) and os.clock() < deadline do
            attempt = attempt + 1
            if attempt % 2 == 1 then
                print("[AUTO PRESTIGE] 4.0 pressing " .. expectedText .. " through UI handler.")
                local ok, message = pcall(click, confirm, "MouseButton1Click")
                if not ok then warn("[AUTO PRESTIGE] 4.0 confirm handler: " .. tostring(message)) end
            else
                clickVirtual(confirm, expectedText)
            end
            local acceptedAt = os.clock() + 5
            repeat
                if confirmationAccepted(expectedText) then
                    print("[AUTO PRESTIGE] 4.0 " .. expectedText .. " accepted.")
                    return
                end
                task.wait(0.1)
            until os.clock() >= acceptedAt
        end
        assert(confirmationAccepted(expectedText), "4.0: " .. expectedText
            .. " did not register after UI-handler and mouse-click attempts.")
    end
    local function selectCard(card, expectedText)
        local frame = cardFrame(card)
        assert(frame, "4.0: card frame missing: " .. tostring(card.Name))
        assert(card.Parent, "4.0: offered card disappeared before selection.")
        selectedCard = card
        local detector = card:FindFirstChild("Click")
        assert(detector and detector:IsA("ClickDetector"), "4.0: card has no Click detector.")
        do
            local paths = {
                {"getconnections", function() return fireHandlers(detector) end},
                {"fireclickdetector", function() return fireDetector(detector) end},
                {"virtual click", function() return fireVirtual(card) end},
            }
            local accepted = false
            for _, path in ipairs(paths) do
                if path[2]() and registered(expectedText, 2) then
                    accepted = true
                    break
                end
                warn("[AUTO PRESTIGE] 4.0 " .. path[1] .. " did not reveal " .. expectedText
                    .. " for " .. card:GetFullName())
                task.wait(0.3)
            end
            assert(accepted, "4.0: card click never registered.")
        end
        waitUntil(function() return isVisible(confirm) and confirm.Title.Text:upper() == expectedText end,
            "selected card confirmation " .. expectedText)
        pressConfirm(expectedText)
    end
    local boosts = offered("Boosts", 90)
    local function goldLabel(value)
        return type(value) == "string"
            and value:gsub("<[^>]*>", ""):upper():match("^%s*(.-)%s*$") == "GOLD BOOST"
    end
    local goldCard, how
    for _, card in ipairs(boosts) do
        local title = findPath(card, {"Holder", "Front", "Main", "Inner", "Middle", "Title"})
        if goldLabel(card.Name) or (title and goldLabel(title.Text)) then
            goldCard, how = card, "Gold Boost label"
            break
        end
    end
    if not goldCard then
        for id, boost in pairs(memories.Boosts) do
            if goldLabel(boost.Tag) then
                for _, card in ipairs(boosts) do
                    if card.Name == boost.Tag or card.Name == tostring(id) then
                        goldCard, how = card, "Gold Boost data"
                        break
                    end
                end
            end
            if goldCard then break end
        end
    end
    assert(goldCard, "4.0: no Gold Boost among " .. #boosts .. " offers; refusing to pick another Boost.")
    print("[AUTO PRESTIGE] 4.0 selecting " .. goldCard.Name .. " (" .. how .. ")")
    selectCard(goldCard, "NEXT")
    local talents = offered("Talents", 60)
    local picked = {}
    for _, card in ipairs(talents) do
        if card.Name ~= "Empty" then picked[#picked + 1] = card end
    end
    assert(#picked > 0, "4.0: every offered talent card is empty.")
    local selected = picked[math.random(1, #picked)]
    print("[AUTO PRESTIGE] 4.0: Gold Boost + random talent " .. selected.Name
        .. " (" .. #picked .. " offered)")
    selectCard(selected, "FINISH")
    waitUntil(function()
        local buttons = interface:FindFirstChild("Memories_Buttons")
        local current = readRank()
        return isVisible(equipment) and buttons and not isVisible(buttons) and current == rank + 1
    end, "completed Prestige and updated rank", 120)
    saveRank(rank + 1)
    print("[AUTO PRESTIGE] 4.0: Prestige " .. (rank + 1) .. " confirmed.")
    -- Rank/UI visibility can update before the cutscene cleanup and Equipment fade finish.
    print("[AUTO PRESTIGE] Waiting for post-Prestige UI to remain stable for 5 seconds...")
    local stableSince
    waitUntil(function()
        local closeout = interface:FindFirstChild("Closeout")
        local topbarUI = interface:FindFirstChild("Topbar")
        local buttons = interface:FindFirstChild("Memories_Buttons")
        local upgrades = findPath(equipment, {"Categories", "Upgrades", "Main", "Interact"})
        local stable = workspace:FindFirstChild("World") ~= nil
            and workspace:FindFirstChild("Paths") == nil
            and isVisible(equipment) and topbarUI and isVisible(topbarUI)
            and buttons and not isVisible(buttons)
            and (not closeout or not isVisible(closeout))
            and upgrades and isVisible(upgrades)
        if not stable then
            stableSince = nil
            return false
        end
        stableSince = stableSince or os.clock()
        return os.clock() - stableSince >= 5
    end, "stable post-Prestige Equipment UI", 45)
    print("[AUTO PRESTIGE] Post-Prestige UI settled; continuing to Upgrades.")
end

local function startMission(player, difficulty)
    local remote = awaitPath(ReplicatedStorage, {"Assets", "Remotes", "GET"})
    local config = {Name = "Shiganshina", Type = "Missions", Objective = "Breach", Difficulty = difficulty}
    local function matches(candidate)
        if typeof(candidate) ~= "Instance" or not candidate.Parent
            or not candidate:IsA("StringValue") or candidate.Name ~= config.Name then return false end
        local leader = candidate:FindFirstChild("Leader")
        return leader and leader.Value == player.Name and candidate.Value == config.Difficulty
            and candidate:GetAttribute("Type") == config.Type
            and candidate:GetAttribute("Objective") == config.Objective
    end
    local function findMission()
        local folder = ReplicatedStorage:FindFirstChild("Missions")
        local found
        if folder then
            for _, candidate in ipairs(folder:GetChildren()) do
                if matches(candidate) then
                    assert(not found, "Multiple matching missions; disband duplicates first.")
                    found = candidate
                else
                    local leader = candidate:FindFirstChild("Leader")
                    assert(not leader or leader.Value ~= player.Name,
                        "You lead another mission; disband it before running.")
                end
            end
        end
        return found
    end
    local mission = findMission()
    if not mission then
        print("[AUTO PRESTIGE] Step 2: creating Shiganshina / Breach / " .. difficulty)
        remote:InvokeServer("S_Missions", "Create", config)
        mission = waitForValue(findMission)
    end
    assert(mission, "Mission did not replicate; check party and difficulty unlocks.")
    local wanted = configEnv.Modifiers
    local known = {"No Perks", "No Skills", "No Memories", "Nightmare", "Injury Prone",
        "Chronic Injuries", "Fog", "Glass Cannon", "Time Trial", "Fatigue", "Evolution",
        "Oddball", "Boring", "Simple", "Primitive"}
    local selected, excluded = {}, {}
    for _, name in ipairs(wanted) do selected[name] = true end
    for _, name in ipairs(known) do if not selected[name] then excluded[#excluded + 1] = name end end
    local function enabled(name)
        assert(matches(mission), "Mission changed or you are no longer leader.")
        local state = mission:GetAttribute("Modifiers")
        assert(type(state) == "string", "Modifiers attribute is not ready.")
        return state:find(name, 1, true) ~= nil
    end
    assert(waitForValue(function() return type(mission:GetAttribute("Modifiers")) == "string" end),
        "Modifiers did not load.")
    local function setModifier(name, target)
        if enabled(name) == target then return end
        print("[AUTO PRESTIGE] " .. (target and "Enable: " or "Disable: ") .. name)
        remote:InvokeServer("S_Missions", "Modify", name)
        local deadline = os.clock() + 8
        repeat
            task.wait(0.2)
            if enabled(name) == target then task.wait(0.5); return end
        until os.clock() >= deadline
        -- Modify toggles state; never blindly retry a delayed request.
        error("Modifier not confirmed: " .. name .. " | " .. tostring(mission:GetAttribute("Modifiers")))
    end
    for _, name in ipairs(excluded) do setModifier(name, false) end
    for _, name in ipairs(wanted) do setModifier(name, true) end
    task.wait(1)
    for _, name in ipairs(excluded) do assert(not enabled(name), "Excluded modifier enabled: " .. name) end
    for _, name in ipairs(wanted) do assert(enabled(name), "Missing modifier: " .. name) end
    print("[AUTO PRESTIGE] Step 2: confirmed " .. #wanted .. " configured modifiers; requesting Start.")
    remote:InvokeServer("S_Missions", "Start")
    print("[AUTO PRESTIGE] Start requested.")
end

