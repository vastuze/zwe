local function childPath(node, names)
    for _, name in ipairs(names) do node = node and node:FindFirstChild(name) end
    return node
end

local function visible(node)
    if not node or not node:IsDescendantOf(game) then return false end
    while node and node ~= game do
        if node:IsA("GuiObject") and not node.Visible then return false end
        if node:IsA("CanvasGroup") and node.GroupTransparency >= 0.99 then return false end
        if node:IsA("ScreenGui") and not node.Enabled then return false end
        node = node.Parent
    end
    return true
end

local function parseNumber(text)
    local cleaned = tostring(text):gsub(",", ""):gsub("%s", "")
    local number, suffix = cleaned:match("^%+?(%d+%.?%d*)([kKmMbB]?)$")
    if not number then return nil end
    return tonumber(number) * (({k = 1000, m = 1000000, b = 1000000000})[suffix:lower()] or 1)
end

local function formatNumber(number)
    local text = tostring(math.floor(number)):reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (text:gsub("^,", ""))
end

