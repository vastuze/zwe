local function upgradeAll(player, interface, equipment, values)
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    local remotes = assets and assets:FindFirstChild("Remotes")
    local Event = remotes and remotes:FindFirstChild("GET")
    if not Event then
        warn("[AUTO PRESTIGE] GET Remote not found for upgradeAll.")
        return nil, nil
    end

    local statsList = {
        "Blade_Durability",
        "ODM_Gas",
        "ODM_Range",
        "ODM_Control",
        "ODM_Speed",
        "Crit_Damage",
        "Crit_Chance",
        "ODM_Damage"
    }

    print("[AUTO PRESTIGE] Upgrading equipment 100% via Remote (no click)...")

    local totalUpgrades = 0
    local lastData = nil

    -- Lặp lại gọi Remote cho đến khi nâng hết số vàng có thể nâng (tối đa 120 lần để chống lặp vô hạn)
    for i = 1, 120 do
        -- Sắp xếp ưu tiên chỉ số cấp thấp hơn nếu có dữ liệu
        if lastData then
            local weapon = lastData.Weapon or (lastData.Slots and lastData.Current_Slot and lastData.Slots[lastData.Current_Slot] and lastData.Slots[lastData.Current_Slot].Weapon) or "Blades"
            local upTable = (lastData.Upgrades and (lastData.Upgrades[weapon] or lastData.Upgrades["Blades"] or lastData.Upgrades["Spears"]))
                or (lastData.Slots and lastData.Current_Slot and lastData.Slots[lastData.Current_Slot] and lastData.Slots[lastData.Current_Slot].Upgrades and (lastData.Slots[lastData.Current_Slot].Upgrades[weapon] or lastData.Slots[lastData.Current_Slot].Upgrades["Blades"]))
            if upTable then
                table.sort(statsList, function(a, b)
                    return (upTable[a] or 0) < (upTable[b] or 0)
                end)
            end
        end

        local ok, data = pcall(function()
            return Event:InvokeServer("S_Equipment", "Upgrade", statsList)
        end)

        -- Nếu server trả về nil nghĩa là không đủ vàng hoặc lỗi
        if not ok or data == nil or type(data) ~= "table" then
            break
        end

        lastData = data
        totalUpgrades = totalUpgrades + 1
        task.wait(0.08) -- Giãn cách 0.08s giữa các lần nâng
    end

    if totalUpgrades > 0 then
        print(string.format("[AUTO PRESTIGE] Completed %d upgrade rounds via Remote!", totalUpgrades))
    else
        print("[AUTO PRESTIGE] No upgrades purchased (maxed or insufficient Gold).")
    end

    local newPotential = nil

    -- Cập nhật lại giao diện Topbar & Title trên màn hình của game
    if lastData then
        -- 1. Tính toán Potential trực tiếp từ cấp độ 8 chỉ số của serverData
        local weapon = lastData.Weapon or (lastData.Slots and lastData.Current_Slot and lastData.Slots[lastData.Current_Slot] and lastData.Slots[lastData.Current_Slot].Weapon) or "Blades"
        local upTable = (lastData.Upgrades and (lastData.Upgrades[weapon] or lastData.Upgrades["Blades"] or lastData.Upgrades["Spears"]))
            or (lastData.Slots and lastData.Current_Slot and lastData.Slots[lastData.Current_Slot] and lastData.Slots[lastData.Current_Slot].Upgrades and (lastData.Slots[lastData.Current_Slot].Upgrades[weapon] or lastData.Slots[lastData.Current_Slot].Upgrades["Blades"]))
        if upTable then
            local minLvl = 15
            for _, stat in ipairs(statsList) do
                local lvl = tonumber(upTable[stat]) or 0
                if lvl < minLvl then minLvl = lvl end
            end
            newPotential = minLvl
            print(string.format("[AUTO PRESTIGE] Potential tinh tu 8 chi so: %d -> [%s GRADE]", newPotential, values.Pot_Tags[newPotential] or "?"))
        end

        -- 2. Thử gọi Shared.Get_Potential nếu chưa có
        if not newPotential then
            pcall(function()
                local SharedModule = ReplicatedStorage:FindFirstChild("Modules")
                    and ReplicatedStorage.Modules:FindFirstChild("Shared")
                    and ReplicatedStorage.Modules.Shared:FindFirstChild("Shared")
                if SharedModule then
                    local Shared = require(SharedModule)
                    local pot = Shared.Get_Potential(nil, player, lastData)
                    if type(pot) == "number" then newPotential = pot end
                end
            end)
        end

        -- 3. Cập nhật số dư vàng thực tế sau khi nâng cấp vào file rewards_gold
        local remainingGold = lastData.Gold
            or (lastData.Currency and type(lastData.Currency.Gold) == "number" and lastData.Currency.Gold)
            or (lastData.Slots and lastData.Current_Slot and lastData.Slots[lastData.Current_Slot] and lastData.Slots[lastData.Current_Slot].Currency and lastData.Slots[lastData.Current_Slot].Currency.Gold)
        if type(remainingGold) == "number" and type(writefile) == "function" then
            pcall(function()
                local goldFile = "rewards_gold_" .. tostring(game.GameId) .. "_" .. tostring(player.UserId) .. ".json"
                local gData = {
                    userId = player.UserId,
                    gameId = game.GameId,
                    balance = remainingGold,
                    gems = lastData.Gems or (lastData.Currency and lastData.Currency.Gems)
                }
                writefile(goldFile, game:GetService("HttpService"):JSONEncode(gData))
                print(string.format("[AUTO PRESTIGE] Da cap nhat so du Vang sau khi nang cap: %s", tostring(remainingGold)))
            end)
        end

        -- 4. Cập nhật UI Topbar & Equipment Title
        pcall(function()
            local TopbarModule = ReplicatedStorage:FindFirstChild("Modules") 
                and ReplicatedStorage.Modules:FindFirstChild("User Interface")
                and ReplicatedStorage.Modules["User Interface"]:FindFirstChild("Topbar")
            if TopbarModule then
                local Topbar = require(TopbarModule)
                if Topbar and Topbar.Refresh then
                    Topbar.Refresh(player, lastData)
                end
            end

            if newPotential and values.Pot_Tags[newPotential] then
                local gradeTag = values.Pot_Tags[newPotential]
                print(string.format("[AUTO PRESTIGE] Current Grade after upgrade: [%s GRADE]", gradeTag))

                local title = findPath(equipment, {"Categories", "Upgrades", "Main", "Title"})
                if title then
                    title.Text = "UPGRADES [" .. gradeTag .. " GRADE]"
                end
            end
        end)
    end
    print("[AUTO PRESTIGE] Equipment upgrade via Remote finished.")
    return lastData, newPotential, totalUpgrades
end

local function sendLobbyResult(result, fields)
    local watcher = configEnv.AutoPrestigeRewardsWatcher
    if configEnv.WebhookURL == "" or not watcher or not watcher.send then return end
    table.insert(fields, 1, {name = "Results", value = result, inline = false})
    local ok, sent, reason = pcall(watcher.send, fields, result)
    if not ok or not sent then
        warn("[WEBHOOK] Lobby result not sent; continuing without retry: " .. tostring(ok and reason or "request error"))
    end
end

local function readDifficulty(player)
    local values = require(ReplicatedStorage.Modules.Storage.Values)
    local env = type(getgenv) == "function" and getgenv() or _G

    local gradeIndex = nil
    local grade = nil

    local gui = findPath(player, {"PlayerGui"})
    local interface = gui and findPath(gui, {"Interface"})
    local equipment = interface and findPath(interface, {"Equipment"})

    -- 1. Nâng cấp trang bị 100% bằng Remote, sau đó đọc Grade live (không plan, không file)
    local _, lastData, remotePotential, upgradeRounds = pcall(upgradeAll, player, interface, equipment, values)
    local livePotential = readLivePotential(player)
    if type(remotePotential) == "number" and (not livePotential or remotePotential > livePotential) then
        livePotential = remotePotential
    end
    if type(livePotential) == "number" then
        gradeIndex = livePotential
        grade = values.Pot_Tags[gradeIndex] or (gradeIndex >= 15 and "S-" or "?")
        print(string.format("[AUTO PRESTIGE] Grade live: [%s GRADE] (Pot %d)", tostring(grade), gradeIndex))
    end

    -- 2. Nếu Remote không trả về Grade, thử Shared.Get_Potential (vẫn là dữ liệu live)
    if not gradeIndex then
        pcall(function()
            local SharedModule = ReplicatedStorage:FindFirstChild("Modules")
                and ReplicatedStorage.Modules:FindFirstChild("Shared")
                and ReplicatedStorage.Modules.Shared:FindFirstChild("Shared")
            if SharedModule then
                local Shared = require(SharedModule)
                local pot = (lastData and Shared.Get_Potential(nil, player, lastData))
                    or Shared.Get_Potential(nil, player)
                if pot and values.Pot_Tags[pot] then
                    gradeIndex = pot
                    grade = values.Pot_Tags[pot]
                    print(string.format("[AUTO PRESTIGE] Grade detected from Shared.Get_Potential: [%s GRADE] (Pot %d)", grade, gradeIndex))
                end
            end
        end)
    end

    -- 3. Dự phòng: Equipment Module và text UI (vẫn là dữ liệu live của game)
    if not gradeIndex then
        pcall(function()
            local eqMod = ReplicatedStorage:FindFirstChild("Modules")
                and ReplicatedStorage.Modules:FindFirstChild("User Interface")
                and ReplicatedStorage.Modules["User Interface"]:FindFirstChild("Equipment")
            if eqMod then
                local eq = require(eqMod)
                if eq and type(eq.Potential) == "number" and values.Pot_Tags[eq.Potential] then
                    gradeIndex = eq.Potential
                    grade = values.Pot_Tags[gradeIndex]
                    print(string.format("[AUTO PRESTIGE] Grade detected from Equipment Module: [%s GRADE] (Pot %d)", grade, gradeIndex))
                end
            end
        end)
    end

    -- Thử đọc từ UI Equipment Title (ví dụ: UPGRADES [B GRADE] hoặc UPGRADES [A- GRADE])
    if not gradeIndex and equipment then
        pcall(function()
            local title = findPath(equipment, {"Categories", "Upgrades", "Main", "Title"})
            if title and title.Text ~= "" then
                local text = title.Text:gsub("<[^>]*>", ""):upper()
                local tag = text:match("%[([A-S][%+%-]?)%s*GRADE%]")
                    or text:match("%[GRADE%s*([A-S][%+%-]?)%]")
                    or text:match("%[([A-S][%+%-]?)%]")
                if tag then
                    for index, potTag in pairs(values.Pot_Tags) do
                        if potTag == tag then
                            gradeIndex = index
                            grade = tag
                            print(string.format("[AUTO PRESTIGE] Grade detected from UI Title: [%s GRADE] (Pot %d)", grade, gradeIndex))
                            break
                        end
                    end
                end
            end
        end)
    end

    -- Thử đọc từ UI Stat Current (chỉ đọc nếu Stat panel đang thực sự mở và có tên stat, tránh đọc placeholder [E-] khi UI chưa chọn)
    if not gradeIndex and equipment then
        pcall(function()
            local statName = findPath(equipment, {"Stat", "Inner", "Stat"})
            local cur = findPath(equipment, {"Stat", "Inner", "Upgrade_Values", "Current"})
            if cur and cur.Text ~= "" and statName and statName.Text ~= "" then
                local text = cur.Text:gsub("<[^>]*>", ""):upper()
                local tag = text:match("%[([A-S][%+%-]?)%]")
                if tag and tag ~= "E-" then
                    for index, potTag in pairs(values.Pot_Tags) do
                        if potTag == tag then
                            gradeIndex = index
                            grade = tag
                            print(string.format("[AUTO PRESTIGE] Grade detected from UI Stat Current: [%s GRADE] (Pot %d)", grade, gradeIndex))
                            break
                        end
                    end
                end
            end
        end)
    end

    -- 4. Không đọc được live: coi là Grade thấp nhất (E) để script vẫn tự chạy tiếp
    if not gradeIndex or not grade then
        warn("[AUTO PRESTIGE] Không đọc được Grade live; giả định Grade E (Pot 1) để tiếp tục nâng cấp/farm.")
        gradeIndex = 1
        grade = values.Pot_Tags[1] or "E"
    end

    -- 5. Mục tiêu Grade kế tiếp tính live từ dữ liệu vừa đọc (không lưu plan)
    local gradeGoldTarget, targetGrade = nextGradeTarget(values, gradeIndex)
    if gradeIndex >= 15 then
        print("[AUTO PRESTIGE] Grade " .. tostring(grade) .. " (Pot " .. tostring(gradeIndex) .. ") is MAX grade (S-). No Lobby return needed for upgrades.")
    elseif gradeGoldTarget then
        print("[AUTO PRESTIGE] Grade plan: " .. tostring(grade) .. " (Pot " .. tostring(gradeIndex) .. ") -> Next " .. tostring(targetGrade) .. " needs " .. gradeGoldTarget .. " Gold.")
    end

    -- 6. Lưu Grade vào ledger webhook (Gold/Gems) để place mission đọc lại được.
    local watcher = env.AutoPrestigeRewardsWatcher
    if watcher and watcher.setGrade and grade then
        local stored = watcher.grade and watcher.grade()
        if (upgradeRounds or 0) > 0 or not stored then watcher.setGrade(grade) end
    end

    -- 7. Cập nhật số dư vàng vào ledger
    if watcher and watcher.refreshBalance then watcher.refreshBalance() end

    -- 8. Chọn độ khó thích hợp để vào trận farm tiếp
    local difficultyRanks = {
        ["easy"] = 1,
        ["normal"] = 2,
        ["hard"] = 3,
        ["severe"] = 4,
        ["aberrant"] = 5,
    }
    local maxTarget = tostring(configEnv.MaxDifficulty or "Aberrant"):lower():match("^%s*(.-)%s*$")
    local maxRank = difficultyRanks[maxTarget] or 5
    local difficulty, bestRank = nil, 0
    for _, requirement in pairs(values.Difficulty_Potential.Missions) do
        if type(requirement) == "table" and requirement[1] and requirement[2] then
            local name = tostring(requirement[1]):match("^%s*(.-)%s*$")
            local cleanLower = name:lower()
            if cleanLower ~= "freedom" then
                local rank = difficultyRanks[cleanLower]
                if rank and gradeIndex >= requirement[2] and rank <= maxRank and rank > bestRank then
                    difficulty = name
                    bestRank = rank
                end
            end
        end
    end
    if not difficulty then
        difficulty = "Hard" -- Fallback an toàn để luôn vào trận
    end
    print("[AUTO PRESTIGE] Step 1.5: Grade " .. tostring(grade) .. " (Pot " .. tostring(gradeIndex) .. ") -> Selected Difficulty: " .. difficulty .. " (Capped at Aberrant)")
    return difficulty
end

local function tryPrestige(player)
    local env = type(getgenv) == "function" and getgenv() or _G
    env.AutoPrestigeNotEligible = nil
    local interface = awaitPath(player, {"PlayerGui", "Interface"})
    local equipment = findPath(interface, {"Equipment"})
    local ranks = require(ReplicatedStorage.Modules.Storage.Ranks)

    local function readRank()
        local label = equipment and findPath(equipment, {"Prestige", "Progress", "Title"})
        if label and label.Text ~= "" then
            local text = label.Text:gsub("<[^>]*>", ""):upper():match("^%s*(.-)%s*$")
            if text == "ENLIST" then return 0 end
            for index, rank in pairs(ranks) do
                if text == rank.Tag:upper() then return index end
            end
        end
        -- Thử đọc Rank / Prestige từ Module Core.Update
        local rankFromData = nil
        pcall(function()
            local UpdateModule = ReplicatedStorage:FindFirstChild("Modules")
                and ReplicatedStorage.Modules:FindFirstChild("Core")
                and ReplicatedStorage.Modules.Core:FindFirstChild("Update")
            if UpdateModule then
                local Update = require(UpdateModule)
                local _, liveData = Update.Get_Data({Cache = {Player = player}}, true)
                if liveData then
                    local pRank = liveData.Rank or liveData.Prestige
                        or (liveData.Slots and liveData.Current_Slot and liveData.Slots[liveData.Current_Slot] and (liveData.Slots[liveData.Current_Slot].Rank or liveData.Slots[liveData.Current_Slot].Prestige))
                    if type(pRank) == "number" then
                        rankFromData = pRank
                    end
                end
            end
        end)
        if rankFromData then return rankFromData end
        local saved = env.AutoPrestigeRank
        if saved and type(saved.rank) == "number" then return saved.rank end
        return nil
    end

    local function saveRank(rank)
        local data = {rank = rank, userId = player.UserId, gameId = game.GameId}
        env.AutoPrestigeRank = data
        if type(writefile) == "function" then
            pcall(function()
                writefile(prestigeFile(player), game:GetService("HttpService"):JSONEncode(data))
            end)
        end
    end

    local rank = readRank() or 0
    saveRank(rank)
    if not ranks[rank + 1] then
        print("[AUTO PRESTIGE] Highest rank reached (no rank " .. tostring(rank + 1) .. ").")
        return
    end

    local topbar = require(ReplicatedStorage.Modules["User Interface"].Topbar)
    local gold
    for _, entry in pairs(topbar.Objects) do
        if entry.Module == "Topbar" and entry.Currency == "Gold" and entry.Object then
            gold = entry.Object:GetAttribute("New")
        end
    end
    if type(gold) ~= "number" then
        local goldLabel = findPath(interface, {"Topbar", "Main", "Currencies", "Gold", "Amount"})
        local text = goldLabel and goldLabel.Text:gsub("<[^>]*>", ""):gsub(",", ""):gsub("%s", "")
        if text and text:match("^%d+$") then gold = tonumber(text) end
    end

    local target = configuredPrestigeGold(rank)
    if target == nil then
        print("[AUTO PRESTIGE] P1-P5 configuration complete; skipping further Prestige.")
        return
    end
    local rankTag = ranks[rank] and ranks[rank].Tag or (rank == 0 and "ENLIST" or "?")
    print(string.format("[AUTO PRESTIGE] Prestige rank = %d (%s) | Gold %s | Target P%d = %s",
        rank, tostring(rankTag), tostring(gold), rank + 1, tostring(target)))
    local currentLvl = readPlayerLevel(player)
    if currentLvl and currentLvl < 100 then
        print(string.format("[AUTO PRESTIGE] Prestige skipped: Level hiện tại %d chưa đạt Level 100.", currentLvl))
        return
    end
    if target > 0 and (type(gold) ~= "number" or gold < target) then
        print("[AUTO PRESTIGE] Prestige skipped: Gold below target or exact balance unavailable.")
        return
    end
    -- ========================================================
    -- THỰC HIỆN PRESTIGE 100% BẰNG REMOTE (KHÔNG CLICK)
    -- ========================================================
    print("=======================================================")
    print("[AUTO PRESTIGE] TIẾN HÀNH PRESTIGE 100% BẰNG REMOTE...")
    print("=======================================================")

    local Event = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Remotes"):WaitForChild("GET")
    local Memories = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Storage"):WaitForChild("Memories"))

    -- 1. Tìm Tag chuẩn của Gold Boost
    local goldBoostTag = "Gold Boost"
    if Memories.Boosts then
        for id, boost in pairs(Memories.Boosts) do
            if boost.Tag and string.find(string.upper(boost.Tag), "GOLD") then
                goldBoostTag = boost.Tag
                break
            end
        end
    end
    print("[AUTO PRESTIGE] Chọn Boost: " .. tostring(goldBoostTag))

    -- 2. Dịch 3 ID đã roll ra thành tên thẻ (Tag)
    local rolledIDs = {}
    local root = workspace:FindFirstChild("Objects") 
        and workspace.Objects:FindFirstChild("Blackout") 
        and workspace.Objects.Blackout:FindFirstChild("Memories")
    if root then
        for _, card in ipairs(root:GetChildren()) do
            local info = card:FindFirstChild("Holder") 
                and card.Holder:FindFirstChild("Front")
                and card.Holder.Front:FindFirstChild("Main")
                and card.Holder.Front.Main:FindFirstChild("Inner")
                and card.Holder.Front.Main.Inner:FindFirstChild("Info")
            if info and info:GetAttribute("Category") == "Talents" then
                table.insert(rolledIDs, card.Name)
            end
        end
    end
    if #rolledIDs == 0 then
        rolledIDs = {"18", "3", "2"}
    end

    local talentTags = {}
    local function getTalentInfo(id)
        local strId = tostring(id)
        local numId = tonumber(id)
        for rarity, talents in pairs(Memories.Talents or {}) do
            local info = talents[strId] or (numId and talents[numId])
            if info then
                return info.Tag, rarity, info.Stars
            end
        end
        return tostring(id), "Unknown", 1
    end

    for _, id in ipairs(rolledIDs) do
        local tag, rarity, stars = getTalentInfo(id)
        table.insert(talentTags, {ID = id, Tag = tag})
        print(string.format("[AUTO PRESTIGE] [Talent] ID %s -> Tag: '%s' (%s, %d sao)", tostring(id), tag, rarity, stars or 1))
    end

    local picked = talentTags[1]
    print(string.format("[AUTO PRESTIGE] [★] CHỌN THẺ ĐỂ PRESTIGE: '%s' (ID %s)", picked.Tag, picked.ID))

    local selection = {
        ["Boosts"] = goldBoostTag,
        ["Talents"] = picked.Tag
    }

    print(string.format("[AUTO PRESTIGE] Gửi Remote: Boosts = '%s' | Talents = '%s'...", selection.Boosts, selection.Talents))

    local ok, finalData, skillPoints, rankId = pcall(function()
        return Event:InvokeServer("S_Equipment", "Prestige", selection)
    end)

    -- Dự phòng: Nếu Server muốn nhận ID dạng số thay vì chữ
    if ok and finalData == nil then
        print("[AUTO PRESTIGE] Thử lại phương án 2: Gửi ID thay vì Tag...")
        selection.Talents = tostring(picked.ID)
        ok, finalData, skillPoints, rankId = pcall(function()
            return Event:InvokeServer("S_Equipment", "Prestige", selection)
        end)
    end

    if ok and type(finalData) == "table" and finalData.Progression then
        local newRank = finalData.Progression.Prestige or (rank + 1)
        print("=======================================================")
        print(string.format("[AUTO PRESTIGE] [🎉] PRESTIGE THÀNH CÔNG! Bậc mới: %s | Level mới: %s",
            tostring(newRank),
            tostring(finalData.Progression.Level)
        ))
        print("=======================================================")
        saveRank(newRank)
        sendLobbyResult("PRESTIGE SUCCESS", {
            {name = "New Prestige Rank", value = tostring(newRank), inline = true},
            {name = "New Level", value = tostring(finalData.Progression.Level), inline = true},
            {name = "Skill Points", value = tostring(skillPoints), inline = true},
        })
    else
        warn("[AUTO PRESTIGE] Prestige phản hồi: " .. tostring(ok) .. " | " .. tostring(finalData))
    end
end

