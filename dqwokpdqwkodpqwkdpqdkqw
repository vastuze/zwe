    local equipment = awaitPath(interface, {"Equipment"})
    openEquipment(interface)
    local prestigeTab = awaitPath(equipment, {"Categories", "Prestige", "Main", "Interact"})
    local deadline = os.clock() + 3
    repeat
        if isVisible(prestigeTab) then break end
        task.wait(0.1)
    until os.clock() >= deadline
    if not isVisible(prestigeTab) then
        print("[AUTO PRESTIGE] 4.0: Prestige tab not available for this account yet; continuing to Upgrades.")
        return
    end
    click(prestigeTab)
    task.wait(1)
    local ranks = require(ReplicatedStorage.Modules.Storage.Ranks)
    local function readRank()
        local label = findPath(equipment, {"Prestige", "Progress", "Title"})
        if not label then return nil end
        local text = label.Text:gsub("<[^>]*>", ""):upper():match("^%s*(.-)%s*$")
        if text == "ENLIST" then return 0 end
        for index, rank in pairs(ranks) do if text == rank.Tag:upper() then return index end end
