        clearRefillHold()
        if farm.tween then farm.tween:Cancel(); farm.tween = nil end
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if root then root.Anchored = false end
        pcall(function() game:GetService("UserInputService").MouseBehavior = Enum.MouseBehavior.Default end)
    end
    function farm.stop()
        farm.running = false
        release()
        for _, connection in ipairs(farm.connections) do connection:Disconnect() end
        farm.connections = {}
    end
    stopMissionFarm = farm.stop
    local function remote(name)
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        local remotes = assets and assets:FindFirstChild("Remotes")
        return remotes and remotes:FindFirstChild(name)
    end
    local function path(root, names) return findPath(root, names) end
    local function skipUI()
        local ui = path(player, {"PlayerGui", "Interface", "Skip"})
        if ui and isVisible(ui) then return ui end
    end
    local function canFarm()
        return active() and not farm.cutscenePaused and not skipUI()
    end
