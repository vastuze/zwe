        local function fireButton(button)
            if not button then return false end
            pcall(function()
                for _, name in ipairs({"MouseButton1Down", "MouseButton1Up", "MouseButton1Click", "Activated"}) do
                    local signal = button[name]
                    if signal then
                        if type(firesignal) == "function" then
                            pcall(function() firesignal(signal) end)
                        end
                        if type(getconnections) == "function" then
                            local ok, connections = pcall(function() return getconnections(signal) end)
                            if ok and type(connections) == "table" then
                                for _, connection in pairs(connections) do
                                    if connection.Enabled ~= false and type(connection.Fire) == "function" then
                                        pcall(function() connection:Fire() end)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            return true
        end

        local function triggerRetryButton(rewards)
            return fireButton(findRewardButton(rewards, "retry"))
        end

        local function triggerLeaveButton(rewards)
            return fireButton(findRewardButton(rewards, "leave"))
        end

        -- Text hiển thị của nút: ưu tiên TextButton.Text, không có thì lấy label con tên "Title".
        local function buttonText(button)
            if not button then return "" end
            if button:IsA("TextButton") and button.Text ~= "" then return button.Text end
            local title = button:FindFirstChild("Title")
            if title and title:IsA("TextLabel") then return title.Text end
            return ""
        end

        -- Nút ghi "RETRY (0/1)": 0 = số lượt đã dùng, 1 = tổng số lượt. 0/1 nghĩa là còn 1 lượt.
        local function retryUsage(rewards)
            local used, total = buttonText(findRewardButton(rewards, "retry")):match("%((%d+)%s*/%s*(%d+)%)")
            return tonumber(used), tonumber(total)
        end

        local retryCount = 0
