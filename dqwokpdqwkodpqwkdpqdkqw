local function goldBoostExpired(timer, player)
    if not configEnv.UseGoldBoost or not configEnv.GoldPotionHours or configEnv.GoldPotionHours <= 0 then
        timer.goldBoostSeen = false
        timer.goldBoostZeroSince = nil
        return false
    end
    local boosts = player and player:FindFirstChild("Boosts")
    local gold = boosts and boosts:FindFirstChild("Gold")
    if not gold or not (gold:IsA("NumberValue") or gold:IsA("IntValue")) then
        timer.goldBoostZeroSince = nil
        if timer.goldBoostSeen then
            -- The timer existed and then vanished: treat as expiry instead of
            -- waiting for a value that will not replicate again.
            timer.goldBoostMissingSince = timer.goldBoostMissingSince or os.clock()
            return os.clock() - timer.goldBoostMissingSince >= 5
        end
        return false
    end
    timer.goldBoostMissingSince = nil
    local seconds = gold.Value
    if type(seconds) ~= "number" or seconds ~= seconds or seconds < 0 or seconds == math.huge then
        timer.goldBoostZeroSince = nil
        return false
    end
    if seconds > 0 then
        timer.goldBoostSeen = true
        timer.goldBoostZeroSince = nil
        return false
    end
    -- A potion can expire during the Lobby -> mission transition, so a positive
    -- value may never be observed in this server. A confirmed Lobby purchase or
    -- activation is proof a potion was used; without it, returning would loop.
    if not timer.goldBoostSeen then
        local env = type(getgenv) == "function" and getgenv() or _G
        if env.AutoPrestigeGoldPotionUsed then timer.goldBoostSeen = true end
    end
    if not timer.goldBoostSeen then return false end
    timer.goldBoostZeroSince = timer.goldBoostZeroSince or os.clock()
    return os.clock() - timer.goldBoostZeroSince >= 1
end

local function startLobbyTimer()
    local env = type(getgenv) == "function" and getgenv() or _G
    local previous = env.AutoPrestigeLobbyTimer
    -- Re-executing in the same server must not reset or duplicate the timer.
    if previous and previous.jobId == game.JobId and previous.placeId == game.PlaceId then
        print("[AUTO PRESTIGE] Lobby timer already active.")
        return
    end
    local player = Players.LocalPlayer
    local potential, values = readGradeIndex(player)
    local prestigeGoldTarget = prestigeTarget(player)
    local gradeVerified = type(potential) == "number"
    local isMaxGrade = gradeVerified and potential >= 15
    local gradeGoldTarget, targetGrade = nil, nil
    if gradeVerified and not isMaxGrade then
        gradeGoldTarget, targetGrade = nextGradeTarget(values, potential)
    elseif not gradeVerified then
        -- Place mission không có Modules.Core.Update: giả định Grade E để vẫn về Lobby nâng cấp.
        gradeGoldTarget, targetGrade = nextGradeTarget(values, 1)
        warn("[AUTO PRESTIGE] Grade chưa đọc được trong mission; giả định Grade E ("
            .. tostring(targetGrade) .. " cần " .. tostring(gradeGoldTarget) .. " Gold); sẽ đọc lại mỗi giây.")
    end

    local timer = {
        jobId = game.JobId,
        placeId = game.PlaceId,
        gradeVerified = gradeVerified,
        isMaxGrade = isMaxGrade,
        gradeGoldTarget = gradeGoldTarget,
        gradeTag = targetGrade,
        prestigeGoldTarget = prestigeGoldTarget,
        deadline = nil,
    }
    env.AutoPrestigeLobbyTimer = timer
    goldBoostExpired(timer, player)

    if isMaxGrade then
        print("[AUTO PRESTIGE] Max Grade (S-) detected: Continuous Mission Farming active.")
    elseif gradeGoldTarget then
        print("[AUTO PRESTIGE] In mission: Farming until Grade " .. tostring(targetGrade) .. " (" .. tostring(gradeGoldTarget) .. " Gold) or Gold Boost expiry.")
    else
        print("[AUTO PRESTIGE] In mission: chưa có mốc Vàng (Grade chưa đọc được); sẽ đọc lại mỗi giây, vẫn farm tiếp.")
    end

    task.spawn(function()
        while env.AutoPrestigeLobbyTimer == timer and inMission() do
            if goldBoostExpired(timer, player) then
                timer.reason = "Gold Boost expired; return to Lobby to restock"
                break
            end
            -- Đọc lại Grade mỗi giây cho tới khi xác nhận được (mission: đọc text UI thay cho Core.Update).
            if not timer.gradeVerified then
                local livePotential, liveValues = readGradeIndex(player)
                if type(livePotential) == "number" then
                    timer.gradeVerified = true
                    timer.isMaxGrade = livePotential >= 15
                    if timer.isMaxGrade then
                        timer.gradeGoldTarget, timer.gradeTag = nil, nil
                        print("[AUTO PRESTIGE] Grade live (mission): Pot " .. tostring(livePotential) .. " = MAX (S-).")
                    else
                        timer.gradeGoldTarget, timer.gradeTag = nextGradeTarget(liveValues, livePotential)
                        print(string.format("[AUTO PRESTIGE] Grade live (mission): Pot %d -> Next %s needs %s Gold.",
                            livePotential, tostring(timer.gradeTag), tostring(timer.gradeGoldTarget)))
                    end
                end
            end
            -- Lưu ý: Việc kiểm tra đủ Vàng / Level để Prestige hoặc nâng Grade CHỈ thực hiện tại màn hình Rewards cuối trận, không được ngắt trận giữa chừng.
            task.wait(1)
        end
        while env.AutoPrestigeLobbyTimer == timer and inMission() do
            timer.leaving = true
            if stopMissionFarm then stopMissionFarm() end
            local assets = ReplicatedStorage:FindFirstChild("Assets")
            local remotes = assets and assets:FindFirstChild("Remotes")
            local post = remotes and remotes:FindFirstChild("POST")
            local get = remotes and remotes:FindFirstChild("GET")
            local character = player and player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if root then root.Anchored = false end
            if post and post:IsA("RemoteEvent") then
                pcall(function() post:FireServer("Functions", "Teleport") end)
            end
            if get and get:IsA("RemoteFunction") then
                pcall(function() get:InvokeServer("Functions", "Teleport", "Lobby") end)
            end
            print("[AUTO PRESTIGE] " .. (timer.reason or "Lobby return requested") .. ".")
            task.wait(10)
        end
        if env.AutoPrestigeLobbyTimer == timer then env.AutoPrestigeLobbyTimer = nil end
    end)
end

local function waitForValue(callback)
    local deadline = os.clock() + TIMEOUT
    repeat
        local value = callback()
        if value then return value end
        task.wait(0.25)
    until os.clock() >= deadline
    return nil
end

local function isVisible(button)
    if not button.Parent then return false end
    local node = button
    while node and node ~= game do
        if (node:IsA("GuiObject") and not node.Visible)
            or (node:IsA("CanvasGroup") and node.GroupTransparency >= 0.99)
            or (node:IsA("ScreenGui") and not node.Enabled) then
            return false
        end
        node = node.Parent
    end
    return true
end

local function selectLobby()
    if not waitForValue(function() return game:IsLoaded() end) then
        error("Game did not finish loading within 30 seconds.")
    end
    if not lobbyPlaces[game.GameId] then error("Unsupported game; no known lobby place.") end
    if lobbyPlaces[game.GameId] == game.PlaceId then
        print("[AUTO PRESTIGE] Step 1 complete: already in Lobby.")
        return true
    end
    local player = waitForValue(function() return Players.LocalPlayer end)
    if not player then error("LocalPlayer did not load.") end
    local btn = waitForValue(function()
        local node = player:FindFirstChild("PlayerGui")
        for _, name in ipairs({"Interface", "Title_Screen", "Slots", "A", "Select_A"}) do
            node = node and node:FindFirstChild(name)
        end
        if node and node:IsA("GuiButton") and isVisible(node) then return node end
    end)
    if not btn then error("Visible Select_A button did not load; start from the slot-selection screen.") end

    local function clickAndRelease(target)
        if firesignal then
            pcall(function() firesignal(target.MouseButton1Down) end)
            task.wait(0.08)
            pcall(function() firesignal(target.MouseButton1Up) end)
            pcall(function() firesignal(target.MouseButton1Click) end)
            pcall(function() firesignal(target.Activated) end)
        elseif getconnections then
            for _, c in pairs(getconnections(target.MouseButton1Down)) do c:Fire() end
            task.wait(0.08)
            for _, c in pairs(getconnections(target.MouseButton1Up)) do c:Fire() end
            for _, c in pairs(getconnections(target.MouseButton1Click)) do c:Fire() end
            for _, c in pairs(getconnections(target.Activated)) do c:Fire() end
        end
    end

    clickAndRelease(btn)
    print("[AUTO PRESTIGE] Slot A selected.")

    task.delay(0.05, function()
        local assets = ReplicatedStorage:FindFirstChild("Assets") or ReplicatedStorage:WaitForChild("Assets", 5)
        local remotes = assets and (assets:FindFirstChild("Remotes") or assets:WaitForChild("Remotes", 5))
        local Event = remotes and (remotes:FindFirstChild("GET") or remotes:WaitForChild("GET", 5)) or ReplicatedStorage.Assets.Remotes.GET
        local code = configEnv.AccessCode or "FDC0E702"

        Event:InvokeServer("Functions", "Teleport", "Nil", code)
        task.wait(0.05)
        local res = Event:InvokeServer("Functions", "Teleport", "Lobby", code)
        if res == true or res == nil then
            print("[AUTO PRESTIGE] Lobby teleport requested.")
        end
    end)

    return false
end

local function findPath(root, names)
    local node = root
    for _, name in ipairs(names) do node = node and node:FindFirstChild(name) end
    return node
end

local function awaitPath(root, names)
    local node = waitForValue(function() return findPath(root, names) end)
    assert(node, "UI did not load: " .. table.concat(names, "."))
    return node
end

local function click(button, preferredEvent, stillNeeded)
    assert(button:IsA("GuiButton"), "Not a UI button: " .. button:GetFullName())

    -- 1. Try getconnections (firing active handlers directly without mouse)
    if type(getconnections) == "function" then
        for _, eventName in ipairs({"Activated", "MouseButton1Click", "MouseButton1Down"}) do
            local ok, handlers = pcall(function() return getconnections(button[eventName]) end)
            if ok and type(handlers) == "table" and #handlers > 0 then
                for _, connection in pairs(handlers) do
                    if connection.Enabled ~= false and type(connection.Fire) == "function" then
                        pcall(function() connection:Fire() end)
                    end
                end
            end
        end
    end

    -- 2. Try firesignal full sequence directly on the instance (no cursor movement)
    if type(firesignal) == "function" then
        pcall(function() firesignal(button.MouseButton1Down) end)
        task.wait(0.02)
        pcall(function() firesignal(button.MouseButton1Up) end)
        pcall(function() firesignal(button.MouseButton1Click) end)
        pcall(function() firesignal(button.Activated) end)
    end
end

