local function readPlayerLevel(targetPlayer)
    local p = targetPlayer or Players.LocalPlayer
    -- 1. Thử từ Core.Update với dummy Core table {Cache = {Player = p}}
    local ok, level = pcall(function()
        local UpdateModule = ReplicatedStorage:FindFirstChild("Modules")
            and ReplicatedStorage.Modules:FindFirstChild("Core")
            and ReplicatedStorage.Modules.Core:FindFirstChild("Update")
        if UpdateModule then
            local Update = require(UpdateModule)
            local dummy = {Cache = {Player = p}}
            local _, liveData = Update.Get_Data(dummy, true)
            if liveData then
                local prog = liveData.Progression
                    or (liveData.Slots and liveData.Current_Slot and liveData.Slots[liveData.Current_Slot] and liveData.Slots[liveData.Current_Slot].Progression)
                if prog and type(prog.Level) == "number" and prog.Level > 0 then
                    return prog.Level
                end
            end
        end
    end)
    if ok and type(level) == "number" and level > 0 then return level end

    -- 2. Thử từ leaderstats của Player
    if p then
        local ls = p:FindFirstChild("leaderstats")
        if ls then
            for _, name in ipairs({"Level", "Lvl", "LVL"}) do
                local val = ls:FindFirstChild(name)
                if val and (val:IsA("IntValue") or val:IsA("NumberValue")) and val.Value > 0 then
                    return val.Value
                end
            end
        end

        -- 3. Thử từ Attributes của player hoặc character
        local attr = p:GetAttribute("Level") or p:GetAttribute("Lvl")
        if type(attr) == "number" and attr > 0 then return attr end
        if p.Character then
            local cAttr = p.Character:GetAttribute("Level") or p.Character:GetAttribute("Lvl")
            if type(cAttr) == "number" and cAttr > 0 then return cAttr end
        end

        -- 4. Thử quét UI Interface (Topbar, HUD, Rewards, v.v.)
        local gui = p:FindFirstChild("PlayerGui")
        local interface = gui and gui:FindFirstChild("Interface")
        if interface then
            local topbarLevel = findPath(interface, {"Topbar", "Main", "Profile", "Level"})
                or findPath(interface, {"Topbar", "Main", "Level"})
                or findPath(interface, {"Topbar", "Main", "Info", "Level"})
            if topbarLevel and topbarLevel:IsA("TextLabel") and topbarLevel.Text ~= "" then
                local num = tonumber(topbarLevel.Text:gsub("<[^>]*>", ""):match("(%d+)"))
                if num and num > 0 and num <= 200 then return num end
            end

            for _, desc in ipairs(interface:GetDescendants()) do
                if desc:IsA("TextLabel") and desc.Visible and desc.Text ~= "" then
                    local raw = desc.Text:gsub("<[^>]*>", ""):gsub("%s", "")
                    local lvlMatch = raw:match("^[Ll][Vv][Ll]%.?(%d+)$") or raw:match("^[Ll][Ee][Vv][Ee][Ll]%.?(%d+)$")
                    if lvlMatch then
                        local num = tonumber(lvlMatch)
                        if num and num > 0 and num <= 200 then return num end
                    end
                end
            end
        end
    end

    return nil
end

local function prestigeTarget(player)
    local env = type(getgenv) == "function" and getgenv() or _G
    local saved = env.AutoPrestigeRank
    if type(readfile) == "function" then
        local ok, value = pcall(function()
            return game:GetService("HttpService"):JSONDecode(readfile(prestigeFile(player)))
        end)
        if ok then saved = value end
    end
    if type(saved) == "table" and saved.userId == player.UserId and saved.gameId == game.GameId
        and type(saved.rank) == "number" and saved.rank >= 0 and saved.rank < 5 then
        local target = configuredPrestigeGold(saved.rank)
        if type(target) == "number" and target >= 0 then return target end
    end
end

local function gradeTagFromText(raw)
    if type(raw) ~= "string" or raw == "" then return nil end
    local text = raw:gsub("<[^>]*>", ""):upper()
    return text:match("%[([A-S][%+%-]?)%s*GRADE%]")
        or text:match("%[GRADE%s*([A-S][%+%-]?)%]")
        or text:match("^%s*([A-S][%+%-]?)%s*$")
end

-- Đọc Grade từ text UI, giống cách webhook đọc Gold/Gems từ Topbar khi không có module.
local function readGradeFromUI(targetPlayer)
    local p = targetPlayer or Players.LocalPlayer
    local gui = p and p:FindFirstChild("PlayerGui")
    local interface = gui and gui:FindFirstChild("Interface")
    if not interface then return nil end
    local equipment = interface:FindFirstChild("Equipment")
    if equipment then
        local node = equipment:FindFirstChild("Categories")
        node = node and node:FindFirstChild("Upgrades")
        node = node and node:FindFirstChild("Main")
        node = node and node:FindFirstChild("Title")
        local tag = node and gradeTagFromText(node.Text)
        if tag then return tag end
        local stat = equipment:FindFirstChild("Stat")
        stat = stat and stat:FindFirstChild("Inner")
        local current = stat and stat:FindFirstChild("Upgrade_Values")
        current = current and current:FindFirstChild("Current")
        if current and current.Text ~= "" then
            local found = current.Text:gsub("<[^>]*>", ""):upper():match("%[([A-S][%+%-]?)%]")
            if found and found ~= "E-" then return found end
        end
    end
    for _, obj in ipairs(interface:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Text ~= "" then
            local text = obj.Text:gsub("<[^>]*>", ""):upper()
            if text:find("GRADE", 1, true) then
                local tag = gradeTagFromText(text)
                if tag then return tag end
            end
        end
    end
end

-- Đọc Potential (Grade) trực tiếp từ dữ liệu live của game, không dùng file/plan.
local function readLivePotential(targetPlayer)
    local p = targetPlayer or Players.LocalPlayer
    local values = require(ReplicatedStorage.Modules.Storage.Values)
    local UpdateModule = ReplicatedStorage:FindFirstChild("Modules")
        and ReplicatedStorage.Modules:FindFirstChild("Core")
        and ReplicatedStorage.Modules.Core:FindFirstChild("Update")
    if not UpdateModule then return nil, values end
    local Update = require(UpdateModule)
    -- Core.Update truy cập self.Cache, nên phải truyền bảng Core có Cache.Player.
    local ok, liveData = pcall(function() return select(2, Update.Get_Data({Cache = {Player = p}}, true)) end)
    if not (ok and liveData) then
        ok, liveData = pcall(function() return select(2, Update.Get_Data(nil, true)) end)
    end
    if not (ok and liveData) then return nil, values end

    local weapon = liveData.Weapon
        or (liveData.Slots and liveData.Current_Slot and liveData.Slots[liveData.Current_Slot] and liveData.Slots[liveData.Current_Slot].Weapon)
        or "Blades"
    local upTable = (liveData.Upgrades and (liveData.Upgrades[weapon] or liveData.Upgrades["Blades"] or liveData.Upgrades["Spears"]))
        or (liveData.Slots and liveData.Current_Slot and liveData.Slots[liveData.Current_Slot] and liveData.Slots[liveData.Current_Slot].Upgrades
            and (liveData.Slots[liveData.Current_Slot].Upgrades[weapon] or liveData.Slots[liveData.Current_Slot].Upgrades["Blades"]))
    if not upTable then return nil, values end

    local statsList = {"Blade_Durability", "ODM_Gas", "ODM_Range", "ODM_Control",
        "ODM_Speed", "Crit_Damage", "Crit_Chance", "ODM_Damage"}
    local minLvl = 15
    local found = false
    for _, stat in ipairs(statsList) do
        if upTable[stat] ~= nil then
            found = true
            local lvl = tonumber(upTable[stat]) or 0
            if lvl < minLvl then minLvl = lvl end
        end
    end
    if not found then return nil, values end
    return minLvl, values
end

-- Potential ưu tiên live data, rồi Shared.Get_Potential, cuối cùng là text Grade trên UI.
-- Place mission không có Modules.Core.Update nên phải có đường UI dự phòng.
local function readGradeIndex(targetPlayer)
    local p = targetPlayer or Players.LocalPlayer
    local potential, values = readLivePotential(p)
    if type(potential) ~= "number" then
        pcall(function()
            local SharedModule = ReplicatedStorage:FindFirstChild("Modules")
                and ReplicatedStorage.Modules:FindFirstChild("Shared")
                and ReplicatedStorage.Modules.Shared:FindFirstChild("Shared")
            if SharedModule then
                local pot = require(SharedModule).Get_Potential(nil, p)
                if type(pot) == "number" then potential = pot end
            end
        end)
    end
    if type(potential) == "number" then return potential, values end
    local tag = readGradeFromUI(p)
    if tag and values and values.Pot_Tags then
        for index, potTag in pairs(values.Pot_Tags) do
            if potTag == tag then return index, values end
        end
    end
    return nil, values
end

-- Vàng cần để lên Grade kế tiếp, tính live từ Potential (không lưu plan).
local function nextGradeTarget(values, potential)
    if not values or type(potential) ~= "number" or potential >= 15 then return nil, nil end
    local price = values.Upgrade_Costs and values.Upgrade_Costs[potential + 1]
    if type(price) ~= "number" or price <= 0 then return nil, nil end
    return math.floor(price) * 8, values.Pot_Tags and values.Pot_Tags[potential + 1]
end

