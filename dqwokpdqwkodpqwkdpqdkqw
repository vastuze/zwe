    local ok, saved = pcall(function() return HttpService:JSONDecode(readfile(goldFile)) end)
    if ok and type(saved) == "table" and saved.userId == player.UserId
        and saved.gameId == game.GameId and validBalance(saved.balance) then
        goldLedger.balance = saved.balance
        goldLedger.lastMatch = type(saved.lastMatch) == "string" and saved.lastMatch or nil
        print("[WEBHOOK] Da doc Gold da luu: " .. formatNumber(saved.balance))
    end
    if ok and type(saved) == "table" and saved.userId == player.UserId
        and saved.gameId == game.GameId and validBalance(saved.gems) then
        goldLedger.gems = saved.gems
        goldLedger.gemsMatch = type(saved.gemsMatch) == "string" and saved.gemsMatch or nil
        print("[WEBHOOK] Da doc Gems da luu: " .. formatNumber(saved.gems))
    end
end

local function saveGold()
    local ok = false
    if type(writefile) == "function" then
        ok = pcall(function()
            writefile(goldFile, HttpService:JSONEncode({userId = player.UserId, gameId = game.GameId,
                balance = goldLedger.balance, lastMatch = goldLedger.lastMatch,
                gems = goldLedger.gems, gemsMatch = goldLedger.gemsMatch}))
        end)
    end
    if not ok and not storageWarned then
        storageWarned = true
        warn("[WEBHOOK] Khong luu duoc Gold ra file; so du co the mat sau teleport.")
    end
end

local function captureLobbyGold(interface)
    local gemsAmount = childPath(interface, {"Topbar", "Main", "Currencies", "Gems", "Amount"})
    if gemsAmount and visible(gemsAmount) then
        local gems = parseNumber(gemsAmount.Text)
        if validBalance(gems) and gems ~= goldLedger.gems then
            goldLedger.gems = gems
            saveGold()
            print("[WEBHOOK] Da luu Gems tu UI lobby: " .. formatNumber(gems))
        end
    end
    local amount = childPath(interface, {"Topbar", "Main", "Currencies", "Gold", "Amount"})
    -- Do not overwrite an estimate with stale, hidden in-match UI.
    if not amount or not visible(amount) then return end
    local balance = parseNumber(amount.Text)
    if not validBalance(balance) or balance == goldLedger.balance then return end
    goldLedger.balance = balance
    saveGold()
    print("[WEBHOOK] Da luu Gold tu UI lobby: " .. formatNumber(balance))
end

local function applyGoldReward(matchId, reward)
    if not validBalance(reward) or goldLedger.lastMatch == matchId then return end
    if validBalance(goldLedger.balance) then goldLedger.balance = goldLedger.balance + reward end
    goldLedger.lastMatch = matchId
    saveGold()
end

loadGold()
app.goldBalance = goldLedger.balance

local function applyGemsReward(matchId, reward)
    if not validBalance(reward) or goldLedger.gemsMatch == matchId then return end
    if validBalance(goldLedger.gems) then goldLedger.gems = goldLedger.gems + reward end
    goldLedger.gemsMatch = matchId
    saveGold()
end

local hoverNames = setmetatable({}, {__mode = "k"})

local function cleanText(text)
    return (tostring(text):gsub("<[^>]*>", ""):gsub("_", " "):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function textSnapshot(root)
    local result = {}
    for _, node in ipairs(root:GetDescendants()) do
        if node:IsA("TextLabel") or node:IsA("TextButton") then
            result[node] = {text = cleanText(node.Text), shown = visible(node)}
        end
    end
    return result
end

local function chooseTooltip(before, after)
    local best, bestScore, ambiguous = nil, 0, false
    for node, entry in pairs(after) do
        local old = before[node]
        local changed = not old or not old.shown or old.text ~= entry.text
        local text = entry.text
        if entry.shown and changed and text ~= "" and #text <= 100 and not text:find("\n")
            and not parseNumber(text) then
            local key = node.Name:lower()
            local score = 0
            -- Accept named title fields, not arbitrary changed stats/descriptions.
            if key == "title" or key == "name" or key == "itemname" or key == "rewardname" then score = 10 end
            local parent = node.Parent
            while parent do
                local name = parent.Name:lower()
                if name:find("tooltip", 1, true) or name == "hover" then
                    if key ~= "description" and key ~= "quantity" then score = score + 5 end
                    break
                end
                parent = parent.Parent
            end
            if key == "description" or key == "quantity" or key == "amount" then score = 0 end
            if score > bestScore then
                best, bestScore, ambiguous = text, score, false
            elseif score > 0 and score == bestScore and text ~= best then
                ambiguous = true
            end
        end
    end
    if not ambiguous then return best end
end

local function fireHover(frame, eventName)
    if type(getconnections) ~= "function" then return false end
    local ok, connections = pcall(function() return getconnections(frame[eventName]) end)
    if not ok then return false end
    local fired = false
    for _, connection in ipairs(connections) do
        local success = pcall(function() connection:Fire() end)
        fired = fired or success
    end
    return fired
end

-- Compatibility with the supplied script: last qualifying Interface label.
-- This is a heuristic, not proof that the selected label is an item name.
local function legacyHoverName(interface)
    if not interface then return nil end
    local name
    for _, node in ipairs(interface:GetDescendants()) do
        if node:IsA("TextLabel") and node.Name ~= "Quantity" then
            local text = cleanText(node.Text)
            if text ~= "" and text ~= "OBTAINED" and text ~= "STATS" and text ~= "MISSION COMPLETED" then
                name = text
            end
        end
    end
    return name
end

local function readHoverNames(items, main)
    local root = player:FindFirstChild("PlayerGui")
    if not root then return end
    for _, item in ipairs(items:GetChildren()) do
        if env.AutoPrestigeRewardsWatcher ~= watcher or not visible(main) then return end
        local frame = item:FindFirstChild("Main")
        local icon = childPath(item, {"Main", "Inner", "Icon"})
        local cached = hoverNames[item]
        if frame and (not cached or cached.icon ~= (icon and icon.Image)) then
            -- Shared tooltip: hover/read each tile in a single fast pass.
            fireHover(frame, "MouseLeave")
            local name
            local ok = pcall(function()
                local before = textSnapshot(root)
                if not fireHover(frame, "MouseEnter") then return end
                task.wait(0.1)
                if not visible(main) then return end
                name = chooseTooltip(before, textSnapshot(root))
                    or legacyHoverName(root:FindFirstChild("Interface"))
                if name and parseNumber(name) then name = nil end
            end)
            fireHover(frame, "MouseLeave")
            if ok and name then
                hoverNames[item] = {icon = icon and icon.Image, name = name}
                print("[WEBHOOK] Hover " .. item.Name .. " -> " .. name)
            else
                warn("[WEBHOOK] Chua doc duoc tooltip cua " .. item.Name .. "; can kiem tra Effects.Hover / getconnections.")
            end
        end
    end
end

local function formatItemName(name)
    local text = cleanText(name):lower()
    return (text:gsub("%a", string.upper, 1))
end

