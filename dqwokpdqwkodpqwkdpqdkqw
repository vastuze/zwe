    task.wait(0.8)
    local input = game:GetService("VirtualInputManager")
    input:SendKeyEvent(true, Enum.KeyCode.Tab, false, game)
    task.wait(0.08)
    input:SendKeyEvent(false, Enum.KeyCode.Tab, false, game)
