end

local function claimQuestNotifications(player)
    local interface = awaitPath(player, {"PlayerGui", "Interface"})
    local ui = awaitPath(interface, {"Quests"})
    local function waitUI(check, message)
        assert(waitForValue(check), message)
    end
    if not isVisible(ui) then
        print("[AUTO PRESTIGE] Waiting for Quests button initialization...")
        local deadline = os.clock() + 60
        local button, stableSince
        repeat
            button = findPath(interface, {"Topbar", "Main", "Categories", "Quests", "Interact"})
            local ready = button and button:IsA("GuiButton") and isVisible(button)
            if ready and type(getconnections) == "function" then
                local ok, handlers = pcall(function() return getconnections(button.MouseButton1Click) end)
                -- Some executors cannot expose handlers; allow the input fallback after a bounded wait.
                if ok and type(handlers) == "table" then
                    ready = false
                    for _, connection in pairs(handlers) do
                        if connection.Enabled ~= false then ready = true; break end
                    end
                end
            end
            if ready then stableSince = stableSince or os.clock() else stableSince = nil end
            if stableSince and os.clock() - stableSince >= 1 then break end
            if isVisible(ui) then break end
            task.wait(0.25)
        until os.clock() >= deadline
        for attempt = 1, 3 do
            if isVisible(ui) then break end
            button = findPath(interface, {"Topbar", "Main", "Categories", "Quests", "Interact"})
            assert(button and isVisible(button), "Quests entry is unavailable after initialization wait.")
            print("[AUTO PRESTIGE] Opening Quests, attempt " .. attempt .. "/3")
            click(button, "MouseButton1Click")
            local openedDeadline = os.clock() + 5
            repeat
                if isVisible(ui) then break end
                task.wait(0.1)
            until os.clock() >= openedDeadline
        end
        assert(isVisible(ui), "Quests did not open after initialization wait and 3 attempts.")
        task.wait(1)
    end
    local tabs = {{"Main", "Q_1"}, {"Side", "Q_2"}, {"Spears", "Q_2.1"},
        {"Daily", "Q_4"}, {"Weekly", "Q_5"}}
    for week = 1, 10 do tabs[#tabs + 1] = {"Week_" .. week, string.format("Q_7.%02d", week)} end
    local categories = awaitPath(ui, {"Main", "Quests"})
    local details = awaitPath(ui, {"Main", "Details"})
    for _, tab in ipairs(tabs) do
        local row = categories:FindFirstChild(tab[2])
        local badge = row and findPath(row, {"Inner", "Title", "New"})
        if row and isVisible(row) and badge and isVisible(badge)
            and (not (badge:IsA("ImageLabel") or badge:IsA("ImageButton")) or badge.ImageTransparency < 0.99) then
            task.wait(0.3)
            click(awaitPath(row, {"Inner", "Interact"}), "MouseButton1Click")
            waitUI(function()
                local title = findPath(details, {"Title", "Title"})
                return title and title.Text:upper() == tab[1]:gsub("_", " "):upper() .. " QUESTS"
                    and isVisible(details)
            end, "Quest category did not open: " .. tab[1])
            task.wait(0.75)
            local attempted = {}
            while true do
                assert(isVisible(ui), "Quests closed during claims.")
                local button, claimed, tag
                for _, quest in ipairs(details.Quests:GetChildren()) do
                    local candidate = findPath(quest, {"Inner", "Claim", "Button"})
                    local name = candidate and candidate:GetAttribute("Tag")
                    if candidate and isVisible(candidate) and type(name) == "string"
                        and candidate:GetAttribute("Category") == tab[1] and not attempted[name] then
                        button, tag = candidate, name
                        claimed = findPath(quest, {"Inner", "Claimed"})
                        break
                    end
                end
                if not button then break end
                attempted[tag] = true
                task.wait(0.3)
                click(button, "MouseButton1Click")
                waitUI(function()
                    return button.Parent and button:GetAttribute("Tag") == nil and claimed and isVisible(claimed)
                end, "Quest claim not confirmed; no retry: " .. tag)
                print("[AUTO PRESTIGE] Quest claimed: " .. tag)
            end
        end
    end
end

local function chooseGoldPotion(balance, products, remainingSeconds)
    if remainingSeconds <= 0 then return nil end
    for _, product in ipairs(products) do
        if balance >= product.cost and product.seconds <= remainingSeconds then return product end
    end
    local smallest = products[#products]
    if smallest and remainingSeconds < smallest.seconds and balance >= smallest.cost then return smallest end
end

local function ensureGoldPotion(player)
    print("[POTION] Effective config: UseGoldBoost=" .. tostring(configEnv.UseGoldBoost)
        .. " | GoldPotionHours=" .. tostring(configEnv.GoldPotionHours))
    if not configEnv.UseGoldBoost or configEnv.GoldPotionHours == 0 then
        print("[POTION] Disabled by effective config; skipping.")
        return
    end
    local targetSeconds = configEnv.GoldPotionHours * 3600
    local interface = awaitPath(player, {"PlayerGui", "Interface"})
    local function timer()
        local value = findPath(player, {"Boosts", "Gold"})
        if value and (value:IsA("NumberValue") or value:IsA("IntValue"))
            and value.Value >= 0 and value.Value < math.huge then return value.Value end
    end
    local initial = timer()
    assert(initial, "Gold Potion timer unavailable; purchases skipped.")
    print("[POTION] Remaining=" .. initial .. "s | Target=" .. targetSeconds .. "s")
    if initial >= targetSeconds - 10 then
        print("[AUTO PRESTIGE] Gold Potion target already met. Remaining seconds: " .. initial)
        return
    end
    local shop = require(ReplicatedStorage.Modules.Storage.Shop)
    local products = {
        {index = 9, tag = "2x Gold Boost [2h]", cost = 13999, seconds = 7200},
        {index = 8, tag = "2x Gold Boost [1h]", cost = 7999, seconds = 3600},
        {index = 7, tag = "2x Gold Boost [30m]", cost = 4499, seconds = 1800},
    }
    for _, product in ipairs(products) do
        local entry = shop["1_Boosts"] and shop["1_Boosts"][product.index]
        assert(entry and entry.Tag == product.tag and entry.Currency == "Gems" and entry.Cost == product.cost,
            "Gold Potion product/price changed; purchases skipped.")
    end
    -- Switch back through the game's handler so the live cache refreshes the Topbar.
    openEquipment(interface)
    task.wait(1.5)
    local label = awaitPath(interface, {"Topbar", "Main", "Currencies", "Gems", "Amount"})
    local balance, lastBalance, stableSince
    local balanceDeadline = os.clock() + 20
    repeat
        local text = label.Text:gsub("<[^>]*>", ""):gsub(",", ""):gsub("%s", "")
        balance = text:match("^%d+$") and tonumber(text)
        if balance and balance == lastBalance then
            stableSince = stableSince or os.clock()
        else
            stableSince = nil
        end
        lastBalance = balance
        if stableSince and os.clock() - stableSince >= (balance == 0 and 5 or 2) then break end
        task.wait(0.2)
    until os.clock() >= balanceDeadline
    assert(balance and balance >= 0 and balance < math.huge, "Exact Gems unavailable; purchases skipped.")
    print("[POTION] Gems available: " .. balance)
    local remote = awaitPath(ReplicatedStorage, {"Assets", "Remotes", "GET"})
    -- Recheck after claiming/UI transitions in case a potion was activated meanwhile.
    local current = timer()
    assert(current, "Gold Potion timer unavailable after claims.")
    -- Ignore ten seconds of countdown drift; never buy another whole potion for that alone.
    if current >= targetSeconds - 10 then return end
    local remainingSeconds = math.ceil((targetSeconds - current - 10) / 1800) * 1800
    local limit = math.min(math.floor(balance / 4499), math.ceil(remainingSeconds / 1800))
    for _ = 1, limit do
        local live = timer()
        assert(live, "Potion timer lost; stopping purchases.")
        if live >= targetSeconds - 10 then break end
        remainingSeconds = math.min(remainingSeconds,
            math.ceil((targetSeconds - live - 10) / 1800) * 1800)
        local product = chooseGoldPotion(balance, products, remainingSeconds)
        if not product then break end
        assert(timer(), "Potion timer lost; stopping purchases.")
        print("[AUTO PRESTIGE] Buying " .. product.tag .. " for " .. product.cost .. " Gems.")
        local data = remote:InvokeServer("S_Market", "Buy", "1_Boosts", product.index, 1)
        assert(type(data) == "table", "Potion purchase refused/unconfirmed; no retry.")
        local slot = data.Slots and data.Slots[data.Current_Slot]
        local remaining = slot and slot.Currency and slot.Currency.Gems
        assert(type(remaining) == "number" and remaining >= 0 and remaining < balance,
            "Purchase balance not confirmed; stopping without retry.")
        balance = remaining
        -- Subtract purchased duration so countdown during requests cannot trigger extra purchases.
        remainingSeconds = remainingSeconds - product.seconds
        local before = timer()
        assert(before, "Potion bought but timer lost; leaving item in inventory.")
        remote:InvokeServer("S_Inventory", "Item", product.tag)
        assert(waitForValue(function()
            local after = timer()
            return after and after - before >= product.seconds - 60
        end), "Potion use not confirmed; no further purchase or use.")
        print("[AUTO PRESTIGE] Potion confirmed; Gems: " .. balance .. " | Timer: " .. tostring(timer()))
        local seconds = math.floor(timer())
        sendLobbyResult("GOLD POTION USED", {
            {name = "Potion", value = product.tag, inline = true},
            {name = "Gems remaining", value = tostring(balance), inline = true},
            {name = "Gold Boost Remaining Time", value = string.format("%02d:%02d:%02d",
                math.floor(seconds / 3600), math.floor(seconds / 60) % 60, seconds % 60), inline = true},
        })
        task.wait(0.3)
    end
    local final = timer()
    if final and final >= targetSeconds - 10 then
        print("[POTION] Target reached: " .. final .. "s | Gems: " .. balance)
    else
        warn("[POTION] Target NOT reached: remaining=" .. tostring(final) .. "s / " .. targetSeconds
            .. "s | Gems=" .. balance .. "; continuing farm without claiming success.")
    end
end

local function waitLobbyAutoexec(player)
    print("[AUTO PRESTIGE] Autoexec: waiting at least 15 seconds for Lobby initialization...")
    local started = os.clock()
    local stableSince, previousUI
    repeat
        local ui = findPath(player, {"PlayerGui", "Interface"})
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local ready = root and ui and findPath(ui, {"Topbar", "Main", "Categories", "Quests", "Interact"})
            and findPath(ui, {"Topbar", "Main", "Categories", "Equipment", "Interact"})
            and findPath(ui, {"Topbar", "Main", "Icons", "Achievements"})
            and findPath(ui, {"Quests", "Main", "Details"})
            and ui:FindFirstChild("Equipment") and ui:FindFirstChild("Achievements")
            and findPath(player, {"Boosts", "Gold"})
        if ready and ui == previousUI then
            stableSince = stableSince or os.clock()
        else
            stableSince = nil
        end
        previousUI = ui
        if stableSince and os.clock() - stableSince >= 3 and os.clock() - started >= 9 then
            print("[AUTO PRESTIGE] Lobby UI loaded; starting menu setup.")
            return
        end
        task.wait(0.25)
    until os.clock() - started >= 120
    error("Lobby UI initialization timed out; no claim or purchase started.")
end

local function runPrestigeFlow()
    -- A new execution resumes the appropriate branch after each place teleport.
    if inMission() then
        print("[AUTO PRESTIGE] Map: Auto Farm + Retry + Skip + Rewards Webhook.")
        print("[POTION] Mission branch: top-up purchases run in Lobby, not inside missions.")
        startRewardsWebhook()
        startLobbyTimer()
        startMissionFarm()
        return
    end

    -- Menu: select Slot A and request Lobby; never run Lobby UI in the menu.
    if not selectLobby() then
        print("[AUTO PRESTIGE] Re-run in Lobby: Claim All -> Upgrade All -> Grade -> mission.")
        return
    end
    local player = waitForValue(function() return Players.LocalPlayer end)
    assert(player, "LocalPlayer did not load.")
    waitLobbyAutoexec(player)
    ensureLobby2D(player)

    -- Background balance capture must run in Lobby too, to carry Gold/Gems into map.
    startRewardsWebhook()
    print("[AUTO PRESTIGE] Lobby: Achievements -> Quests -> Gold Potion -> Prestige -> Upgrades.")
    claimAllAchievements(player)
    local questsOK, questsError = pcall(claimQuestNotifications, player)
    if not questsOK then
        warn("[AUTO PRESTIGE] Quests skipped; continuing Lobby setup: " .. tostring(questsError))
    end
    -- Prestige is checked before Upgrade All can spend the threshold balance.
    local boosted, boostError = pcall(ensureGoldPotion, player)
    if not boosted then warn("[AUTO PRESTIGE] Gold Potion skipped: " .. tostring(boostError)) end
    tryPrestige(player)
    local difficulty = readDifficulty(player)
    print("[AUTO PRESTIGE] Mission: Shiganshina/Breach -> configured modifiers -> Start.")
    startMission(player, difficulty)
end

    local ok, message = pcall(runPrestigeFlow)
if not ok then warn("[AUTO PRESTIGE] Stopped: " .. tostring(message)) end
