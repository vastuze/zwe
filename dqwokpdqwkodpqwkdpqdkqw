        local timer = env.AutoPrestigeLobbyTimer
        return farm.running and env.AutoPrestigeFarm == farm and inMission()
            and not (timer and (timer.leaving or os.clock() >= timer.deadline))
            and not (timer and goldBoostExpired(timer, player))
    end
