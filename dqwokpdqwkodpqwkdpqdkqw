                        end)
                    end
                end
            elseif farm.cutscenePaused then
                clickedUI = nil
                local resumeAt = os.clock() + 0.1
                repeat task.wait(0.05) until not active() or skipUI() or os.clock() >= resumeAt
                if active() and not skipUI() then
                    farm.cutscenePaused = false
                    print("[AUTO PRESTIGE] Step 2.7: Skip UI closed; checking farm readiness after 0.1 seconds.")
                end
            end
            task.wait(0.1)
        end
    end)
    farm.connections[#farm.connections + 1] = player.CharacterAdded:Connect(function(character)
        release()
        local root = character:WaitForChild("HumanoidRootPart", 5)
        if root then root.Anchored = false end
    end)
    local function key(code)
        input:SendKeyEvent(true, code, false, game)
        task.wait(0.05)
        input:SendKeyEvent(false, code, false, game)
    end
    -- One Retry request per visible Rewards screen; never retry while leaving.
    task.spawn(function()
        local wasVisible = false
        while active() do
            task.wait(0.1)
            local main = path(player, {"PlayerGui", "Interface", "Rewards", "Main"})
            local shown = main and isVisible(main) or false
            if shown and not wasVisible and canFarm() then
                wasVisible = true
                task.wait(0.5)
                -- Give the Rewards tracker time to capture items before Retry hides the UI.
                -- Do not block farming/Retry indefinitely on HTTP or tooltip failures.
                local captureDeadline = os.clock() + 4
                while active() and main.Parent and isVisible(main) and os.clock() < captureDeadline do
                    local watcher = env.AutoPrestigeRewardsWatcher
                    if not watcher or watcher.readyMain == main then break end
                    task.wait(0.1)
                end
                if canFarm() and main.Parent and isVisible(main) then
                    local timer = env.AutoPrestigeLobbyTimer
                    local plan = timer and timer.gradePlan
                    local watcher = env.AutoPrestigeRewardsWatcher
                    local gold = watcher and watcher.balance and watcher.balance()
                    local prestigeGold = timer and timer.prestigeGoldTarget
                    if prestigeGold and type(gold) == "number" and gold >= prestigeGold then return end
                    if plan and type(plan.goldTarget) == "number" and type(gold) == "number"
                        and gold >= plan.goldTarget then
                        -- Let the return monitor handle this reward instead of starting another round.
                        return
                    end
                    local get = remote("GET")
                    if get and get:IsA("RemoteFunction") then
                        local ok, err = pcall(function() get:InvokeServer("Functions", "Retry", "Add") end)
                        if not ok then warn("[AUTO PRESTIGE] Retry failed: " .. tostring(err)) end
                    end
                end
            elseif not shown then wasVisible = false end
        end
    end)
    task.spawn(function()
        local keys = {W = Enum.KeyCode.W, A = Enum.KeyCode.A, S = Enum.KeyCode.S, D = Enum.KeyCode.D}
        while active() do
            task.wait(0.1)
            pcall(function()
                local gui = player:FindFirstChild("PlayerGui")
                if not gui then return end
                for _, label in ipairs(gui:GetDescendants()) do
                    if not canFarm() then return end
                    if label.Name == "Key" and label:IsA("TextLabel") and isVisible(label) then
                        local code = keys[label.Text:upper()]
                        if code then key(code) end
                    end
                end
            end)
        end
    end)
    local function rig(character)
        return workspace:FindFirstChild("Rig_" .. character.Name, true) or character
    end
    local function bladeStatus(character)
        local characters = workspace:FindFirstChild("Characters")
        local model = characters and characters:FindFirstChild(character.Name)
            or workspace:FindFirstChild("Rig_" .. character.Name, true) or character
        -- A missing replicated model is not proof that the blades are empty.
        if not model then return nil, nil end
        local count, segments, slotsFound = 0, 0, 0
        for index = 1, 3 do
            local set = model:FindFirstChild("Left_" .. index, true)
            if set then
                slotsFound = slotsFound + 1
                if not set:GetAttribute("Used") then count = count + 1 end
            end
        end
        if slotsFound == 0 then return nil, nil end
        local seen = {}
        -- Equipped segments may be outside LeftHand. Scan the whole model,
        -- excluding stored sets, so 0/3 reserves does not discard the final blade.
        for _, part in ipairs(model:GetDescendants()) do
            if part:IsA("BasePart") then
                local index = tonumber(part.Name:match("^Blade_(%d+)$"))
                local stored = false
                local ancestor = part.Parent
                while ancestor and ancestor ~= model do
                    if ancestor.Name:match("^Left_[123]$") or ancestor.Name:match("^Right_[123]$") then
                        stored = true
                        break
                    end
                    ancestor = ancestor.Parent
                end
                if index and index >= 1 and index <= 7 and not seen[index]
                    and not stored and not part:GetAttribute("Broken") and part.Transparency < 1 then
                    seen[index] = true
                    segments = segments + 1
                end
            end
        end
        return count, segments
    end
    local function getRefillPart()
        -- Breach uses Objective.Breach.HQ, not the generic Props.HQ.
        -- Resolve by name: GetChildren()[186] is not a stable identifier.
        for _, names in ipairs({
            {"Unclimbable", "Objective", "Breach", "HQ"},
            {"Unclimbable", "Props", "HQ"},
        }) do
            local hq = path(workspace, names)
            if hq then
                local nearest, distance = nil, math.huge
                local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                for _, part in ipairs(hq:GetDescendants()) do
                    if part.Name == "Refill" and part:IsA("BasePart") then
                        local magnitude = root and (root.Position - part.Position).Magnitude or 0
                        if magnitude < distance then nearest, distance = part, magnitude end
                    end
                end
                if nearest then return nearest end
            end
        end
    end
    local function napeOf(titan)
        return path(titan, {"Hitboxes", "Hit", "Nape"}) or titan:FindFirstChild("Nape", true)
    end
    local lastRefillWarning = -10
    local emptySince, emptyCharacter
    local function refillWarning(message)
        if os.clock() - lastRefillWarning >= 10 then
            lastRefillWarning = os.clock()
            warn("[AUTO PRESTIGE] Refill: " .. message)
        end
    end
    local waitReason, waitLoggedAt
    local function reportFarmWait(reason)
        if waitReason ~= reason or not waitLoggedAt or os.clock() - waitLoggedAt >= 5 then
            print("[AUTO PRESTIGE] Farm waiting: " .. reason)
            waitLoggedAt = os.clock()
        end
        waitReason = reason
    end
    local function iteration()
        if not canFarm() then task.wait(0.1); return end
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid or humanoid.Health <= 0 then
            reportFarmWait("character/root/humanoid not ready")
            release(); task.wait(0.1); return
        end
        local function valid()
            return canFarm() and player.Character == character and root.Parent == character and humanoid.Health > 0
        end
        local setsLeft, segmentsLeft = bladeStatus(character)
        if setsLeft == nil then
            emptySince, emptyCharacter = nil, nil
            refillWarning("Blade slots not replicated; cannot determine remaining sets.")
            reportFarmWait("blade reserve slots not replicated")
            release(); task.wait(0.1); return
        end
        if setsLeft == 0 and segmentsLeft == 0 then
            -- Wait for a stable 0/7, not a temporary gap while blades are changing.
            if emptyCharacter ~= character then
                emptyCharacter, emptySince = character, os.clock()
            elseif not emptySince then
                emptySince = os.clock()
            end
            if os.clock() - emptySince < 0.5 then
                release()
                holdBeforeRefill(root)
                task.wait(0.1)
                return
            end
            release()
            holdBeforeRefill(root)
            local station, post = getRefillPart(), remote("POST")
            if station and post and post:IsA("RemoteEvent") and valid() then
                local oldCF = root.CFrame
                print("[AUTO PRESTIGE] Blades empty: teleporting to " .. station:GetFullName())
                local ok, err = pcall(function()
                    clearRefillHold()
                    root.Anchored = false
                    root.CFrame = station.CFrame + Vector3.new(0, 3, 0)
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    -- Allow arrival replication, but return immediately if reserves are already full.
                    local arrivalDeadline = os.clock() + 1
                    repeat
                        if not valid() then return end
                        if bladeStatus(character) == 3 then return end
                        task.wait(0.05)
                    until os.clock() >= arrivalDeadline
                    if not valid() then return end
                    if bladeStatus(character) == 3 then return end
                    post:FireServer("Attacks", "Reload", station)
                    -- Only wait for reserve sets (3/3), not equipped segment replication.
                    local deadline = os.clock() + 10
                    repeat
                        if not valid() then return end
                        local sets = bladeStatus(character)
                        if sets == 3 then return end
                        task.wait(0.05)
                    until os.clock() >= deadline
                    error("Reload did not confirm 3/3 blade sets within 10 seconds.")
                end)
                if valid() then
                    root.CFrame = CFrame.new(oldCF.Position.X, math.max(configEnv.Height, oldCF.Position.Y), oldCF.Position.Z)
                        * oldCF.Rotation
                    root.Anchored = true
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    if ok then print("[AUTO PRESTIGE] Blades 3/3: returned above previous position at configured height; resuming farm.") end
                    -- No fixed cooldown after 3/3; the next iteration may resume farming.
                end
                if not ok then warn("[AUTO PRESTIGE] Refill failed: " .. tostring(err)) end
            else
                refillWarning(not station and "HQ refill part not found."
                    or "POST remote or character not ready.")
                task.wait(0.5)
            end
            return
        end
        emptySince, emptyCharacter = nil, nil
        clearRefillHold()
        local titans = workspace:FindFirstChild("Titans")
        local target, nape, nearest = nil, nil, math.huge
        if titans then
            for _, titan in ipairs(titans:GetChildren()) do
                local hum = titan:IsA("Model") and titan:FindFirstChild("Humanoid")
                local neck = hum and napeOf(titan)
                if hum and hum.Health > 0 and neck and neck:IsA("BasePart") then
                    local distance = (root.Position - neck.Position).Magnitude
                    if distance < nearest then target, nape, nearest = titan, neck, distance end
                end
            end
        end
        if not target then
            reportFarmWait("no living titan with a replicated Nape hitbox")
            root.Anchored = false
            task.wait(0.1)
            if not valid() then release() end
            return
        end
        if waitReason then
            print("[AUTO PRESTIGE] Farm ready; target: " .. target.Name)
            waitReason, waitLoggedAt = nil, nil
        end
        local hand = rig(character):FindFirstChild("LeftHand", true)
        local blade = hand and hand:FindFirstChild("Blade_1")
        if blade and blade:GetAttribute("Broken") == true then
            root.Anchored = true
            key(Enum.KeyCode.R)
            task.wait(0.6)
            root.Anchored = false
        end
        if not valid() or not nape.Parent then return end
        root.Anchored = false
        local height = math.max(configEnv.Height, nape.Position.Y + 50)
        local destination = CFrame.new(nape.Position.X, height, nape.Position.Z) * CFrame.new(0, 0, 2)
        local duration = math.max(0.05, (root.Position - destination.Position).Magnitude / configEnv.Speed)
        local tween = tweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = destination})
        farm.tween = tween
        local finished, playbackState = false, nil
        local completedConnection = tween.Completed:Connect(function(state)
            playbackState, finished = state, true
        end)
        tween:Play()
        local empty = false
        -- Wait for actual completion, retaining cancellation for Skip/refill/Lobby.
        while valid() and nape.Parent and not finished do
            local sets, segments = bladeStatus(character)
            if sets == 0 and segments == 0 then empty = true; break end
            task.wait(0.05)
        end
        if not finished then tween:Cancel() end
        completedConnection:Disconnect()
        if farm.tween == tween then farm.tween = nil end
        if empty then
            if valid() then holdBeforeRefill(root) else release() end
            return
        end
        if not valid() or not nape.Parent then release(); return end
        if playbackState ~= Enum.PlaybackState.Completed then return end
        root.Anchored = true
        local post = remote("POST")
        if post then
            pcall(function()
                post:FireServer("Attacks", "Slash", true)
                post:FireServer("Hitboxes", "Register", nape, math.random() * 0.1 + 0.05)
                post:FireServer("Attacks", "Slash", false)
            end)
        end
        input:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        input:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        task.wait(0.15)
        -- Keep the character anchored between farm iterations, not during refill/cutscenes.
        if valid() then root.Anchored = true else release() end
    end
    task.spawn(function()
        while active() do
            local ok, err = pcall(iteration)
            if not ok then release(); warn("[AUTO PRESTIGE] Farm: " .. tostring(err)); task.wait(1) end
            task.wait()
        end
        farm.stop()
    end)
    print("[AUTO PRESTIGE] Step 2.5: Auto Farm + Auto Retry enabled (no HUD).")
end

local function ensureLobby2D(player)
    local interface = awaitPath(player, {"PlayerGui", "Interface"})
    local categories = awaitPath(interface, {"Topbar", "Main", "Categories"})
    local function menuVisible()
        if not interface.Parent then return false end
        local topbar = interface:FindFirstChild("Topbar")
        local main = topbar and topbar:FindFirstChild("Main")
        if not topbar or not main then return false end
        local shown = isVisible(topbar) and isVisible(main) and isVisible(categories)
        if not shown then return false end
        for _, name in ipairs({"Equipment", "Inventory", "Market"}) do
            local category = categories:FindFirstChild(name)
            local interact = category and category:FindFirstChild("Interact")
            if interact and isVisible(interact) then return true end
        end
        return false
    end
