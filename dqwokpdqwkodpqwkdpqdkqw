        if heightGuard then heightGuard.enabled = false end
        local state = {character = character, root = root, minimumY = minimumY}
        heightGuard = state
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        task.spawn(function()
            while active() and heightGuard == state do
                if not root.Parent or player.Character ~= character
                    or not humanoid or humanoid.Health <= 0 then break end
                if root.Anchored then
                    if root.AssemblyLinearVelocity.Y > 0 then
