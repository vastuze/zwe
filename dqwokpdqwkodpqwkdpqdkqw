local function makeFields(interface, main, rows, goldSummary)
    local fields = {}
    local state = childPath(main, {"Info", "State"})
    if state and state.Text ~= "" then
        fields[#fields + 1] = {name = "Results", value = matchDetails(state.Text), inline = false}
    end
    for _, stat in ipairs({"Time_Taken", "Damage", "Kills", "Crits"}) do
        local amount = childPath(main, {"Info", "Main", "Stats", stat, "Amount"})
        if amount and amount.Text ~= "" then
            fields[#fields + 1] = {name = stat:gsub("_", " "), value = amount.Text, inline = true}
        end
    end
    fields[#fields + 1] = {name = "Gold Boost Remaining Time", value = goldPotionText(), inline = true}
    fields[#fields + 1] = {name = "Prestige: " .. prestigeText(), value = "\226\128\139", inline = true}
    fields[#fields + 1] = {name = "Các boost", value = boostsText(), inline = false}
    local parts, length = {}, 0
    for _, row in ipairs(rows) do
        if goldSummary and row:match("^%+[%d,]+ Gold$") then
            row = goldSummary.goldLine or row
        end
        if goldSummary and row:match("^%+[%d,]+ Gems$") then
            row = goldSummary.gemsLine or row
        end
        if length + #row + 1 > 850 then
            parts[#parts + 1] = "... danh sach da rut gon"
            break
        end
        parts[#parts + 1], length = row, length + #row + 1
    end
    fields[#fields + 1] = {name = "Rewards", value = #parts > 0 and table.concat(parts, "\n") or "Khong co item tren UI.", inline = false}
    return fields
end

local function resultColor(stateText)
    local text = cleanText(stateText):upper()
    if text:find("FAIL", 1, true) or text:find("DEFEAT", 1, true)
        or text:find("LOST", 1, true) or text:find("LOSS", 1, true) then return 16711680 end
    if text:find("MISSION COMPLETED", 1, true) or text:find("VICTORY", 1, true) then return 65280 end
    return 9807270
end

local function send(fields, stateText, useThumbnail)
    if not app.webhook then return false, "Webhook disabled", 1 end
    local requestCall = request or http_request
    if type(requestCall) ~= "function" and type(syn) == "table" then requestCall = syn.request end
    if type(requestCall) ~= "function" and type(http) == "table" then requestCall = http.request end
    if type(requestCall) ~= "function" then return false, "Executor khong co ham HTTP request", 15 end
    if (app.url or WEBHOOK_URL) == "" or (app.url or WEBHOOK_URL):find("URL_WEBHOOK", 1, true) then return false, "Chua dien WEBHOOK_URL", 30 end
    local ok, response = pcall(function()
        return requestCall({
            Url = app.url or WEBHOOK_URL, Method = "POST", Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                allowed_mentions = {parse = {}},
                embeds = {{title = "Attack on titan revolution - " .. player.Name, color = resultColor(stateText),
                    fields = fields,
                    image = not useThumbnail and configEnv.WebhookImageURL ~= "" and {url = configEnv.WebhookImageURL} or nil,
                    thumbnail = useThumbnail and configEnv.WebhookImageURL ~= "" and {url = configEnv.WebhookImageURL} or nil,
                    timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")}},
            }),
        })
    end)
    if not ok then return false, "Ham HTTP request nem loi (an URL/token)", 10 end
    if type(response) ~= "table" then return false, "Khong nhan duoc HTTP response", 10 end
    local status = tonumber(response.StatusCode or response.Status)
    if status and status >= 200 and status < 300 then return true end
    local delay = 10
    if status == 429 then
        local decoded, body = pcall(function() return HttpService:JSONDecode(response.Body or "") end)
        if decoded and type(body) == "table" then delay = math.max(1, tonumber(body.retry_after) or 10) end
    end
    return false, "Discord HTTP " .. tostring(status or "unknown"), delay
end

